<?xml version="1.0"?>
<sdf version="1.6">
  <world name="single_obstacle_demo">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- A compact room makes the laser scan easy to inspect in RViz. -->
    <model name="room_walls">
      <static>true</static>
      <link name="walls">
        <collision name="north_collision"><pose>0 3.5 0.5 0 0 0</pose><geometry><box><size>8 0.12 1</size></box></geometry></collision>
        <visual name="north_visual"><pose>0 3.5 0.5 0 0 0</pose><geometry><box><size>8 0.12 1</size></box></geometry><material><ambient>0.75 0.75 0.75 1</ambient></material></visual>
        <collision name="south_collision"><pose>0 -3.5 0.5 0 0 0</pose><geometry><box><size>8 0.12 1</size></box></geometry></collision>
        <visual name="south_visual"><pose>0 -3.5 0.5 0 0 0</pose><geometry><box><size>8 0.12 1</size></box></geometry><material><ambient>0.75 0.75 0.75 1</ambient></material></visual>
        <collision name="east_collision"><pose>4 0 0.5 0 0 0</pose><geometry><box><size>0.12 7 1</size></box></geometry></collision>
        <visual name="east_visual"><pose>4 0 0.5 0 0 0</pose><geometry><box><size>0.12 7 1</size></box></geometry><material><ambient>0.75 0.75 0.75 1</ambient></material></visual>
        <collision name="west_collision"><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.12 7 1</size></box></geometry></collision>
        <visual name="west_visual"><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.12 7 1</size></box></geometry><material><ambient>0.75 0.75 0.75 1</ambient></material></visual>
      </link>
    </model>

    <!-- The one obstacle the robot must drive around. -->
    <model name="single_obstacle">
      <static>true</static>
      <pose>0 0 0.55 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.9 1.4 1.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.9 1.4 1.1</size></box></geometry>
          <material><ambient>0.85 0.22 0.12 1</ambient><diffuse>0.85 0.22 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Visual-only goal marker at the end of the route. -->
    <model name="goal_marker">
      <static>true</static>
      <pose>2.5 0 0.012 0 0 0</pose>
      <link name="marker">
        <visual name="visual">
          <geometry><cylinder><radius>0.28</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.85 0.2 1</ambient><diffuse>0.1 0.85 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-0.3 -0.3 10.5 0 1.5707 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
