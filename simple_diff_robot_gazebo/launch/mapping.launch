<?xml version="1.0"?>
<launch>
  <arg name="gui" default="true"/><arg name="rviz" default="true"/>
  <include file="$(find simple_diff_robot_gazebo)/launch/gazebo.launch"><arg name="gui" value="$(arg gui)"/></include>
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame" value="base_footprint"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>
    <param name="map_update_interval" value="2.0"/>
    <param name="maxUrange" value="11.5"/>
    <param name="maxRange" value="12.0"/>
    <param name="linearUpdate" value="0.15"/>
    <param name="angularUpdate" value="0.15"/>
    <param name="temporalUpdate" value="1.0"/>
    <param name="particles" value="30"/>
    <param name="xmin" value="-10.0"/>
    <param name="ymin" value="-10.0"/>
    <param name="xmax" value="10.0"/>
    <param name="ymax" value="10.0"/>
    <param name="delta" value="0.05"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find simple_diff_robot_gazebo)/rviz/mapping.rviz"/>
</launch>
