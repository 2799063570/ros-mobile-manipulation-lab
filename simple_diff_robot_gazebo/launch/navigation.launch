<?xml version="1.0"?>
<launch>
  <arg name="map_file" default="$(find simple_diff_robot_gazebo)/maps/my_map.yaml"/>
  <arg name="gui" default="true"/><arg name="rviz" default="true"/>
  <include file="$(find simple_diff_robot_gazebo)/launch/gazebo.launch"><arg name="gui" value="$(arg gui)"/></include>
  <node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)"/>
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <rosparam file="$(find simple_diff_robot_gazebo)/config/amcl.yaml" command="load"/>
  </node>
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find simple_diff_robot_gazebo)/config/costmap_common.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find simple_diff_robot_gazebo)/config/costmap_common.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find simple_diff_robot_gazebo)/config/global_costmap.yaml" command="load"/>
    <rosparam file="$(find simple_diff_robot_gazebo)/config/local_costmap.yaml" command="load"/>
    <rosparam file="$(find simple_diff_robot_gazebo)/config/dwa_local_planner.yaml" command="load"/>
    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find simple_diff_robot_gazebo)/rviz/navigation.rviz"/>
</launch>
