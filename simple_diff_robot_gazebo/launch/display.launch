<?xml version="1.0"?>
<launch>
  <param name="robot_description"
         command="$(find xacro)/xacro --inorder $(find simple_diff_robot_gazebo)/urdf/simple_diff_robot.xacro"/>
  <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find simple_diff_robot_gazebo)/rviz/model.rviz"/>
</launch>

