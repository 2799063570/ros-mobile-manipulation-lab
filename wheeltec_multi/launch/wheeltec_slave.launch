
<launch>
<!-- +参数设+ -->
	<!-- 从机的期望跟随坐标  以主车为坐标原点  -->
	<arg name="slave_x" default="-0.8"/> 		<!-- slave_x为从车（跟随者）的期望x坐标，主车前方为正方向，单位：m  -->
	<arg name="slave_y" default="0.8"/> 		<!-- slave_y为从车（跟随者）的期望y坐标，主车左方为正方向，单位：m  -->

	<!-- 编队模式选择  1：主车自转，从车围绕主车运动型    2：主车自转，从车原地自转型（从车模仿主车运动）-->
	<!-- akm小车推荐使用编队模式2，非akm小车两种模式皆可 -->
	<!-- 编队模式1下，主车角速度不宜过大 -->
	<arg name="multi_mode" default="2" />
	<!-- leader: slave_x/y 始终表示主车前/左；map: 偏置固定在地图坐标系。 -->
	<arg name="formation_frame" default="leader" />
	<!-- 麦轮底盘默认使用全向控制器；差速/Ackermann 底盘可显式设为 false。 -->
	<arg name="use_mecanum_controller" default="true" />

	<!-- 是否开启避障功能 true / false默认开启-->
	<arg name="avoidance" default="true"/>

	<arg name="max_vel_x" default="0.8" /> <!-- 从车最大线速度限制（绝对值） -->
	<arg name="min_vel_x" default="0.05" /> 	<!-- 从车最小线速度限制（绝对值） -->
	<arg name="max_vel_theta" default="0.8" /> <!-- 从车最大角速度限制（绝对值） -->
	<arg name="min_vel_theta" default="0.05" /> <!-- 从车最小角速度限制（绝对值） -->
	<arg name="mecanum_max_vel_y" default="0.8" />
	<arg name="mecanum_max_linear_vel" default="0.8" />
	<arg name="mecanum_acc_lim" default="0.5" />
	<arg name="mecanum_decel_lim" default="0.8" />
	<arg name="mecanum_leader_timeout" default="0.4" />
	<arg name="mecanum_k_x" default="1.0" />
	<arg name="mecanum_k_y" default="1.0" />
	<arg name="mecanum_k_yaw" default="1.0" />
	<arg name="mecanum_k_i_x" default="0.08" />
	<arg name="mecanum_k_i_y" default="0.08" />
	<arg name="mecanum_integral_limit" default="0.35" />
	<arg name="mecanum_position_tolerance" default="0.03" />
	<arg name="mecanum_yaw_tolerance" default="0.03" />
	<arg name="mecanum_recovery_error" default="0.25" />
	<arg name="mecanum_recovery_gain_scale" default="1.4" />
	<arg name="mecanum_prediction_horizon" default="0.15" />
	<arg name="mecanum_control_rate" default="20.0" />
	<arg name="usart_port_name" default="/dev/wheeltec_controller" />
	<!-- 从车在共享地图中的真实初始位姿；与期望编队偏置 slave_x/slave_y 相互独立。 -->
	<arg name="set_initial_pose" default="false" />
	<arg name="initial_x" default="0.0" />
	<arg name="initial_y" default="0.0" />
	<arg name="initial_yaw" default="0.0" />
	<arg name="require_initial_pose" default="true" />
	<arg name="require_localization_convergence" default="true" />
	<arg name="max_position_stddev" default="0.35" />
	<arg name="max_yaw_stddev" default="0.35" />
<!-- +参数设置+ -->

<!-- 定位 -->
	 <!-- 开启机器人底层相关节点 同时开启自适应蒙特卡洛定位amcl-->
	 <include file="$(find turn_on_wheeltec_robot)/launch/turn_on_wheeltec_robot.launch">
	    <arg name="navigation"  default="true"/>
	    <arg name="usart_port_name" value="$(arg usart_port_name)"/>
	 </include>
	 <!-- turn on lidar开启雷达  -->
	 <include file="$(find turn_on_wheeltec_robot)/launch/wheeltec_lidar.launch" />

	 <!-- 设置需要用于导航的地图  -->
	 <arg name="map_file" default="$(find turn_on_wheeltec_robot)/map/WHEELTEC.yaml"/>
	<node name="map_server_faor_test" pkg="map_server" type="map_server" args="$(arg map_file)">
	</node>

	 <!-- 开启用于导航的自适应蒙特卡洛定位amcl-->
	 <include file="$(find turn_on_wheeltec_robot)/launch/include/amcl.launch" />

	 <!-- 仅在已知真实地图坐标时自动初始化；否则使用 RViz 的 2D Pose Estimate。 -->
	<node if="$(arg set_initial_pose)" name="pose_setter" pkg="wheeltec_multi" type="set_pose.py"
	      args="$(arg initial_x) $(arg initial_y) $(arg initial_yaw)" output="screen" >
		<param name='frame_id' type='string' value='map' />
	</node>
<!-- 定位 -->

<!-- 避障 -->
	<group if="$(arg avoidance)"> 
		<node name='laser_tracker' pkg="simple_follower" type="laserTracker.py"> <!-- 提取最近的障碍物距离信息 -->
			<param name="winSize" value="2" type="int" />
			<param name="deltaDist" value="0.2" type="double" />
		</node>
		<node pkg="wheeltec_multi" type="multi_avoidance" name="multi_avoidance" output="screen" > <!-- 发布速度信息 -->
			<param name="holonomic" type="bool" value="$(arg use_mecanum_controller)" />
			<param name="control_rate" type="double" value="$(arg mecanum_control_rate)" />
			<param name="obstacle_timeout" type="double" value="0.5" />
			<param name="avoidance_kv" type="double" value="0.4" /> 		<!-- 修正从车线速度的参数，参数越大，障碍物对从车减速作用越强 -->
			<param name="avoidance_kw" type="double" value="0.4" /> 		<!-- 修正从车角速度的参数，参数越大，调节从车角度，使车头偏离障碍物的作用越强 -->
			<param name="safe_distence" type="double" value="0.4" /> 		<!-- 安全距离界限 -->
			<param name="danger_distence" type="double" value="0.2" /> 		<!-- 危险距离界限 -->
			<param name="max_vel_x" value="$(arg max_vel_x)" /> <!-- 从车最大线速度限制（绝对值） -->
			<param name="max_vel_y" value="$(arg mecanum_max_vel_y)" />
			<param name="max_linear_vel" value="$(arg mecanum_max_linear_vel)" />
			<param name="min_vel_x" value="$(arg min_vel_x)" /> 	<!-- 从车最小线速度限制（绝对值） -->
			<param name="max_vel_theta" value="$(arg max_vel_theta)" /> 	<!-- 从车最大角速度限制（绝对值） -->  
			<param name="min_vel_theta" value="$(arg min_vel_theta)" /> <!-- 从车最小角速度限制（绝对值） --> 
		</node>
	</group>
<!-- 避障 -->

<!-- 从车编队 -->
	<!-- 从车接受主车位置与速度信息-->
	<node name="listen_tfodom" pkg="wheeltec_multi" type="listen_tfodom.py" output="screen">
		<param name="udp_port" type="int" value="10000" />
		<param name="accept_legacy" type="bool" value="true" />
		<param name="max_clock_skew" type="double" value="0.5" />
		<param name="map_frame" type="string" value="map" />
	</node>
	<!-- 从机位置监听与从机速度控制节点  -->
	<node unless="$(arg use_mecanum_controller)" pkg="wheeltec_multi" type="slave_tf_listener" name="slave_tf_listener" output="screen" >
	  <!-- 参数调节  -->
		<param name="multi_mode" type="int" value="$(arg multi_mode)" /> 		<!-- 编队模式选择 --> 
		<param name="k_v" type="double" value="1.0" /> 			<!-- 调节前后方向偏差时，k_v越大，线速度越大 -->  
		<param name="k_l" type="double" value="1.0" /> 			<!-- 调节左右方向偏差时，k_l越大，角速度越大 -->  
		<param name="k_a" type="double" value="1.0" />			<!-- 调节角度偏差时，k_a越大，角速度越大 -->  
		<param name="slave_x" type="double" value="$(arg slave_x)" />
		<param name="slave_y" type="double" value="$(arg slave_y)" />
		<remap from="cmd_vel_ori" to="cmd_vel" if="$(eval avoidance == false)"/>
		<param name="max_vel_x" value="$(arg max_vel_x)" /> 		<!-- 从车最大线速度限制（绝对值） -->  
		<param name="min_vel_x" value="$(arg min_vel_x)" /> 	<!-- 从车最小线速度限制（绝对值） -->
		<param name="max_vel_theta" value="$(arg max_vel_theta)" /> 	<!-- 从车最大角速度限制（绝对值） -->  
		<param name="min_vel_theta" value="$(arg min_vel_theta)" /> <!-- 从车最小角速度限制（绝对值） --> 
	</node>
	<node if="$(arg use_mecanum_controller)" pkg="wheeltec_multi" type="slave_tf_listener_mecanum" name="slave_tf_listener_mecanum" output="screen" >
		<param name="multi_mode" type="int" value="$(arg multi_mode)" />
		<param name="formation_frame" type="string" value="$(arg formation_frame)" />
		<param name="slave_x" type="double" value="$(arg slave_x)" />
		<param name="slave_y" type="double" value="$(arg slave_y)" />
		<param name="k_x" type="double" value="$(arg mecanum_k_x)" />
		<param name="k_y" type="double" value="$(arg mecanum_k_y)" />
		<param name="k_yaw" type="double" value="$(arg mecanum_k_yaw)" />
		<param name="k_i_x" type="double" value="$(arg mecanum_k_i_x)" />
		<param name="k_i_y" type="double" value="$(arg mecanum_k_i_y)" />
		<param name="integral_limit" type="double" value="$(arg mecanum_integral_limit)" />
		<param name="max_vel_x" value="$(arg max_vel_x)" />
		<param name="max_vel_y" value="$(arg mecanum_max_vel_y)" />
		<param name="max_linear_vel" value="$(arg mecanum_max_linear_vel)" />
		<param name="max_vel_theta" value="$(arg max_vel_theta)" />
		<param name="min_vel_x" value="$(arg min_vel_x)" />
		<param name="min_vel_y" value="$(arg min_vel_x)" />
		<param name="min_vel_theta" value="$(arg min_vel_theta)" />
		<param name="acc_lim_x" type="double" value="$(arg mecanum_acc_lim)" />
		<param name="acc_lim_y" type="double" value="$(arg mecanum_acc_lim)" />
		<param name="acc_lim_theta" type="double" value="1.0" />
		<param name="decel_lim_x" type="double" value="$(arg mecanum_decel_lim)" />
		<param name="decel_lim_y" type="double" value="$(arg mecanum_decel_lim)" />
		<param name="decel_lim_theta" type="double" value="1.5" />
		<param name="leader_timeout" type="double" value="$(arg mecanum_leader_timeout)" />
		<param name="prediction_horizon" type="double" value="$(arg mecanum_prediction_horizon)" />
		<param name="position_tolerance" type="double" value="$(arg mecanum_position_tolerance)" />
		<param name="yaw_tolerance" type="double" value="$(arg mecanum_yaw_tolerance)" />
		<param name="recovery_error" type="double" value="$(arg mecanum_recovery_error)" />
		<param name="recovery_gain_scale" type="double" value="$(arg mecanum_recovery_gain_scale)" />
		<param name="tf_timeout" type="double" value="0.2" />
		<param name="control_rate" type="double" value="$(arg mecanum_control_rate)" />
		<param name="require_initial_pose" type="bool" value="$(arg require_initial_pose)" />
		<param name="require_localization_convergence" type="bool" value="$(arg require_localization_convergence)" />
		<param name="max_position_stddev" type="double" value="$(arg max_position_stddev)" />
		<param name="max_yaw_stddev" type="double" value="$(arg max_yaw_stddev)" />
		<remap from="cmd_vel_ori" to="cmd_vel" if="$(eval avoidance == false)"/>
	</node>
<!-- 从车编队 -->

</launch>

