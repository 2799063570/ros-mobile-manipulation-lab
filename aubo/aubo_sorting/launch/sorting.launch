<?xml version="1.0"?>
<launch>
  <!-- Robot controllers and move_group must already be running. -->
  <arg name="start_perception" default="true"/>
  <arg name="start_task" default="true"/>
  <arg name="task_executable" default="color_sorting_task_cpp"/>
  <!-- image_view/OpenCV 4.2 can abort while closing an unregistered GTK
       window.  Keep publishing /sorting/debug_image, but make the optional
       desktop viewer opt-in so shutdown remains clean and headless-safe. -->
  <arg name="debug_view" default="false"/>
  <arg name="auto_move_to_observation" default="true"/>
  <arg name="auto_start" default="false"/>
  <arg name="use_grasp_attachment" default="true"/>

  <!-- color/yolo 共用几何层，任务侧无需了解检测后端。 -->
  <arg name="detector" default="color"/>
  <arg name="camera_mount" default="eye_in_hand"/>
  <arg name="camera_namespace" default="$(eval '/camera' if arg('camera_mount') == 'eye_in_hand' else '/workspace_camera')"/>
  <arg name="height_mode" default="table"/>
  <arg name="table_z" default="0.10"/>
  <arg name="object_height" default="0.04"/>
  <arg name="use_detected_angle" default="true"/>
  <arg name="use_detected_width" default="false"/>
  <arg name="task_config" default="$(find aubo_sorting)/config/sorting.yaml"/>
  <arg name="colors_config" default="$(find aubo_sorting)/config/colors.yaml"/>
  <arg name="yolo_config" default="$(find aubo_perception)/config/ultralytics_yolo.yaml"/>
  <arg name="debug_image_topic" default="$(eval '/sorting/debug_image' if arg('detector') == 'color' else '/yolo/annotated_image')"/>
  <arg name="perception_config" default="$(find aubo_perception)/config/grasp_pipeline.yaml"/>
  <arg name="python" default="/home/zlab/anaconda3/envs/yolo/bin/python"/>
  <arg name="model_path" default="/home/zlab/deepL/code/ultralytics-main-modify/weights/GC-yolo.pt"/>
  <include if="$(arg start_perception)" file="$(find aubo_perception)/launch/grasp_perception.launch">
    <arg name="colors_config" value="$(arg colors_config)"/>
    <arg name="yolo_config" value="$(arg yolo_config)"/>
    <arg name="detector" value="$(arg detector)"/>
    <arg name="camera_mount" value="$(arg camera_mount)"/>
    <arg name="camera_namespace" value="$(arg camera_namespace)"/>
    <arg name="height_mode" value="$(arg height_mode)"/>
    <arg name="table_z" value="$(arg table_z)"/>
    <arg name="object_height" value="$(arg object_height)"/>
    <arg name="config" value="$(arg perception_config)"/>
    <arg name="python" value="$(arg python)"/>
    <arg name="model_path" value="$(arg model_path)"/>
  </include>

  <node if="$(arg start_task)" pkg="aubo_sorting_core"
        type="$(arg task_executable)" name="color_sorting_task" output="screen">
    <rosparam file="$(arg task_config)" command="load"/>
    <param name="height_mode" value="$(arg height_mode)"/>
    <param name="table_z" value="$(arg table_z)"/>
    <param name="object_height" value="$(arg object_height)"/>
    <param name="use_detected_angle" value="$(arg use_detected_angle)"/>
    <param name="use_detected_width" value="$(arg use_detected_width)"/>
    <param name="auto_move_to_observation" value="$(arg auto_move_to_observation)"/><!-- 自动移动到观察位姿 -->
    <param name="auto_start" value="$(arg auto_start)"/><!-- 自动开始任务 -->
    <param name="use_grasp_attachment" value="$(arg use_grasp_attachment)"/><!-- 是否使用抓取插件 -->
  </node>

  <node if="$(arg debug_view)" pkg="image_view" type="image_view"
        name="sorting_debug_view" output="screen">
    <remap from="image" to="$(arg debug_image_topic)"/>
  </node>
</launch>
