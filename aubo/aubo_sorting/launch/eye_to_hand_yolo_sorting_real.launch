<?xml version="1.0"?>
<launch>
  <arg name="camera_mount" value="eye_to_hand"/>
  <arg name="detector" value="yolo"/>
  <!-- Share the measured real cell; dispatch instances until the pickup area is empty. -->
  <arg name="continuous_sorting" default="true"/>
  <include file="$(find aubo_sorting)/launch/eye_to_hand_can_sorting_real.launch" pass_all_args="true"/>
</launch>
