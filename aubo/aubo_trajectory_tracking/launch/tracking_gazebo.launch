<launch>
  <arg name="gui" default="true"/><arg name="panel" default="true"/><arg name="rviz" default="true"/>
  <arg name="qt_gl_integration" default="xcb_glx"/>
  <env name="QT_XCB_GL_INTEGRATION" value="$(arg qt_gl_integration)"/>
  <arg name="acceleration_ff_time" default="0.10"/>
  <arg name="config" default="$(find aubo_trajectory_tracking)/config/tracking.yaml"/>
  <include file="$(find aubo_ros_control)/launch/cartesian_jog_gazebo.launch">
    <arg name="gui" value="$(arg gui)"/><arg name="panel" value="false"/>
  </include>
  <include file="$(find aubo_trajectory_tracking)/launch/tracking.launch">
    <arg name="acceleration_ff_time" value="$(arg acceleration_ff_time)"/>
    <arg name="joint_states_topic" value="/aubo_i5/joint_states"/>
    <arg name="config" value="$(arg config)"/><arg name="panel" value="$(arg panel)"/><arg name="rviz" value="$(arg rviz)"/>
    <arg name="qt_gl_integration" value="$(arg qt_gl_integration)"/>
  </include>
</launch>
