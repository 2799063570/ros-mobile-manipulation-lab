<?xml version="1.0"?>
<launch>
  <!-- Open-top box: a bottom and four walls, all registered for collision checking. -->
  <arg name="config" default="$(find aubo_planning)/config/sorting_box_reference.yaml"/>
  <node pkg="aubo_planning" type="publish_sorting_box.py"
        name="publish_sorting_box" output="screen" required="true">
    <rosparam command="load" file="$(arg config)"/>
  </node>
</launch>
