<?xml version="1.0"?>
<package format="2">
  <name>aubo_sorting_core</name>
  <version>0.1.0</version>
  <description>Platform-independent MoveIt color sorting state machine for AUBO robots.</description>
  <maintainer email="wheeltec@example.com">WHEELTEC</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>aubo_perception</depend>
  <depend>control_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf</depend>
  <depend>trajectory_msgs</depend>
  <depend>urdf</depend>
  <exec_depend>moveit_commander</exec_depend>
  <export/>
</package>
