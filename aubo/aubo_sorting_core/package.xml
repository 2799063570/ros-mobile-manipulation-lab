<?xml version="1.0"?>
<package format="2">
  <name>aubo_sorting_core</name>
  <version>0.1.0</version>
  <description>Platform-independent MoveIt color sorting state machine for AUBO robots.</description>
  <maintainer email="wheeltec@example.com">WHEELTEC</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>aubo_perception</build_depend>
  <build_depend>rospy</build_depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>aubo_perception</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>moveit_commander</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf</exec_depend>
