<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="yolo_perception">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <model name="sorting_table">
      <static>true</static>
      <pose>0.70 0 0.0 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.70 1.00 0.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.70 1.00 0.20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.47 1</ambient>
            <diffuse>0.55 0.55 0.57 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="beverage_can">
      <pose>0.58 0 0.125 0 1.57079632679 0</pose>
      <link name="can_link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0000494792</ixx>
            <iyy>0.0000494792</iyy>
            <izz>0.000015625</izz>
          </inertia>
        </inertial>
        <collision name="can_collision">
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <!-- Textured can mesh, centered and fitted to the 50 x 100 mm collision. -->
        <visual name="printed_body">
          <geometry>
            <mesh>
              <uri>model://aubo_perception/models/beverage_can/meshes/coke_can.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <physics name="sorting_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>
  </world>
</sdf>
