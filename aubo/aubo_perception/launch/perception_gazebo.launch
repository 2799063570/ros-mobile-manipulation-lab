<launch>
  <arg name="detector" default="color" doc="color | yolo"/>
  <arg name="camera_mount" default="eye_in_hand" doc="eye_in_hand | eye_to_hand"/>
  <!-- Dictionary lookup rejects unsupported mode names during launch parsing. -->
  <arg name="world" default="$(eval find('aubo_perception') + '/worlds/' + {'color': 'color', 'yolo': 'yolo'}[arg('detector')] + '_perception.world')"/>
  <arg name="with_arm" value="$(eval {'eye_in_hand': True, 'eye_to_hand': False}[arg('camera_mount')])"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="auto_move_to_observation" default="true"/>
  <arg name="observation_named_target" default="observe"/>
  <arg name="height_mode" default="depth"/>
  <arg name="table_z" default="0.10"/>
  <arg name="object_height" default="$(eval 0.05 if arg('detector') == 'yolo' else 0.04)"/>
  <arg name="target_frame" default="$(eval 'base_link' if arg('with_arm') else 'world')"/>
  <arg name="config" default="$(find aubo_perception)/config/grasp_pipeline.yaml"/>
  <arg name="colors_config" default="$(find aubo_perception)/config/colors.yaml"/>
  <arg name="yolo_config" default="$(find aubo_perception)/config/ultralytics_yolo.yaml"/>
  <arg name="python" default="/home/zlab/anaconda3/envs/yolo/bin/python"/>
  <arg name="model_path" default="/home/zlab/deepL/code/ultralytics-main-modify/weights/GC-yolo.pt"/>
  <arg name="camera_x" default="0.55"/>
  <arg name="camera_y" default="0.0"/>
  <arg name="camera_z" default="1.60"/>
  <arg name="camera_roll" default="0.0"/>
  <arg name="camera_pitch" default="1.57079632679"/>
  <arg name="camera_yaw" default="0.0"/>

  <group if="$(arg with_arm)">
    <include file="$(find aubo_gazebo)/launch/aubo_world_gazebo.launch">
      <arg name="world_name" value="$(arg world)"/>
      <arg name="gui" value="$(arg gui)"/>
      <arg name="paused" value="$(arg paused)"/>
    </include>
    <include file="$(find aubo_gazebo)/launch/aubo_controller_gazebo.launch"/>
    <node pkg="joint_state_publisher" type="joint_state_publisher" name="aubo_joint_state_relay">
      <rosparam param="source_list">[/aubo_i5/joint_states]</rosparam>
    </node>
    <include file="$(find aubo_moveit_config)/launch/move_group.launch">
      <arg name="allow_trajectory_execution" value="true"/>
      <arg name="fake_execution" value="false"/>
      <arg name="load_robot_description" value="false"/>
      <arg name="robot_xacro" value="aubo_i5_with_camera.xacro"/>
      <arg name="robot_srdf" value="aubo_i5_with_camera.srdf"/>
    </include>
    <node if="$(arg auto_move_to_observation)" pkg="aubo_perception" type="move_to_observation.py"
          name="move_to_observation" output="screen">
      <param name="named_target" value="$(arg observation_named_target)"/>
      <param name="table_z" value="$(arg table_z)"/>
    </node>
    <include if="$(arg rviz)" file="$(find aubo_moveit_config)/launch/moveit_rviz.launch"/>
  </group>

  <group unless="$(arg with_arm)">
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name" value="$(arg world)"/>
      <arg name="gui" value="$(arg gui)"/>
      <arg name="paused" value="$(arg paused)"/>
      <arg name="use_sim_time" value="true"/>
    </include>
    <node pkg="gazebo_ros" type="spawn_model" name="spawn_workspace_camera" output="screen"
          args="-sdf -file $(find aubo_perception)/models/workspace_camera/model.sdf -model workspace_camera -x $(arg camera_x) -y $(arg camera_y) -z $(arg camera_z) -R $(arg camera_roll) -P $(arg camera_pitch) -Y $(arg camera_yaw)"/>
    <include file="$(find aubo_description)/launch/eye_to_hand_camera_tf.launch">
      <arg name="parent_frame" value="world"/>
      <arg name="x" value="$(arg camera_x)"/>
      <arg name="y" value="$(arg camera_y)"/>
      <arg name="z" value="$(arg camera_z)"/>
      <arg name="roll" value="$(arg camera_roll)"/>
      <arg name="pitch" value="$(arg camera_pitch)"/>
      <arg name="yaw" value="$(arg camera_yaw)"/>
    </include>
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="perception_rviz" args="-f world"/>
  </group>

  <include file="$(find aubo_perception)/launch/grasp_perception.launch">
    <arg name="detector" value="$(arg detector)"/>
    <arg name="camera_mount" value="$(arg camera_mount)"/>
    <arg name="target_frame" value="$(arg target_frame)"/>
    <arg name="height_mode" value="$(arg height_mode)"/>
    <arg name="table_z" value="$(arg table_z)"/>
    <arg name="object_height" value="$(arg object_height)"/>
    <arg name="config" value="$(arg config)"/>
    <arg name="colors_config" value="$(arg colors_config)"/>
    <arg name="yolo_config" value="$(arg yolo_config)"/>
    <arg name="python" value="$(arg python)"/>
    <arg name="model_path" value="$(arg model_path)"/>
  </include>
</launch>
