<launch>
  <!-- 机械臂通用入口；两类相机都要求事先完成标定并发布正确 TF。 -->
  <arg name="detector" default="color" doc="color | yolo"/>
  <arg name="camera_mount" default="eye_in_hand"/>
  <arg name="camera_namespace" default="$(eval '/camera' if arg('camera_mount') == 'eye_in_hand' else '/workspace_camera')"/>
  <arg name="task_mode" default="sorting" doc="sorting | servo | both"/>
  <arg name="height_mode" default="table" doc="table | depth"/>
  <arg name="selected_class" default=""/>
  <arg name="config" default="$(find aubo_perception)/config/grasp_pipeline.yaml"/>
  <arg name="colors_config" default="$(find aubo_perception)/config/colors.yaml"/>
  <arg name="yolo_config" default="$(find aubo_perception)/config/ultralytics_yolo.yaml"/>
  <arg name="python" default="/home/zlab/anaconda3/envs/yolo/bin/python"/>
  <arg name="model_path" default="/home/zlab/deepL/code/ultralytics-main-modify/weights/GC-yolo.pt"/>
  <arg name="table_z" default="0.10"/>
  <arg name="object_height" default="0.04"/>
  <arg name="target_frame" default="base_link"/>
  <arg name="boxes_topic" default="/perception/boxes"/>
  <arg name="detections_topic" default="/sorting/detections"/>
  <arg name="image_topic" default="$(arg camera_namespace)/color/image_raw"/>
  <arg name="depth_topic" default="$(arg camera_namespace)/aligned_depth_to_color/image_raw"/>
  <arg name="camera_info_topic" default="$(arg camera_namespace)/color/camera_info"/>

  <group if="$(eval arg('detector') == 'yolo')">
    <include file="$(find aubo_perception)/launch/ultralytics_yolo.launch">
      <!-- Grasp geometry needs live camera timestamps, never an offline image. -->
      <arg name="input_mode" value="topic"/>
      <arg name="image_path" value=""/>
      <arg name="config" value="$(arg yolo_config)"/>
      <arg name="python" value="$(arg python)"/>
      <arg name="model_path" value="$(arg model_path)"/>
      <arg name="image_topic" value="$(arg image_topic)"/>
      <arg name="detections_topic" value="$(arg boxes_topic)"/>
    </include>
  </group>
  <node if="$(eval arg('detector') == 'color')" pkg="aubo_perception"
        type="color_object_detector.py" name="color_object_detector" output="screen">
    <env name="PYTHONNOUSERSITE" value="1"/>
    <rosparam command="load" file="$(arg colors_config)"/>
    <param name="output_mode" value="boxes"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="boxes_topic" value="$(arg boxes_topic)"/>
    <param name="debug_image_topic" value="/sorting/debug_image"/>
  </node>
  <node pkg="aubo_perception" type="yolo_rgbd_target_node.py" name="grasp_geometry" output="screen">
    <env name="PYTHONNOUSERSITE" value="1"/>
    <rosparam command="load" file="$(arg config)"/>
    <param name="detector" value="$(arg detector)"/>
    <param name="backend" value="ultralytics"/>
    <param name="task_mode" value="$(arg task_mode)"/>
    <param name="height_mode" value="$(arg height_mode)"/>
    <param name="camera_mount" value="$(arg camera_mount)"/>
    <param name="selected_class" value="$(arg selected_class)"/>
    <param name="boxes_topic" value="$(arg boxes_topic)"/>
    <param name="aligned_depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="detections_topic" value="$(arg detections_topic)"/>
    <param name="target_frame" value="$(arg target_frame)"/>
    <param name="table_z" value="$(arg table_z)"/>
    <param name="object_height" value="$(arg object_height)"/>
  </node>
</launch>
