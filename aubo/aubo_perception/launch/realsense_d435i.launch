<?xml version="1.0"?>
<launch>
  <!-- 独立 RGB-D 采集入口；安装到机器人时由上层入口决定 TF 发布权。 -->
  <arg name="serial_no" default=""/>
  <arg name="camera_name" default="camera"/>
  <arg name="width" default="640"/>
  <arg name="height" default="480"/>
  <arg name="fps" default="30"/>
  <arg name="enable_pointcloud" default="true"/>
  <arg name="publish_tf" default="true"/>
  <arg name="initial_reset" default="false"/>
  <!-- RGB-D 感知不依赖 IMU，需要惯性数据时显式开启。 -->
  <arg name="enable_imu" default="false"/>
  <arg name="gyro_fps" default="400"/>
  <arg name="accel_fps" default="200"/>

  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="serial_no" value="$(arg serial_no)"/>
    <arg name="camera" value="$(arg camera_name)"/>
    <arg name="tf_prefix" value="$(arg camera_name)"/>
    <arg name="color_width" value="$(arg width)"/>
    <arg name="color_height" value="$(arg height)"/>
    <arg name="depth_width" value="$(arg width)"/>
    <arg name="depth_height" value="$(arg height)"/>
    <arg name="color_fps" value="$(arg fps)"/>
    <arg name="depth_fps" value="$(arg fps)"/>
    <arg name="enable_color" value="true"/>
    <arg name="enable_depth" value="true"/>
    <arg name="align_depth" value="true"/>
    <arg name="enable_sync" value="true"/>
    <arg name="enable_pointcloud" value="$(arg enable_pointcloud)"/>
    <arg name="publish_tf" value="$(arg publish_tf)"/>
    <arg name="initial_reset" value="$(arg initial_reset)"/>
    <arg name="enable_gyro" value="$(arg enable_imu)"/>
    <arg name="enable_accel" value="$(arg enable_imu)"/>
    <arg name="gyro_fps" value="$(arg gyro_fps)"/>
    <arg name="accel_fps" value="$(arg accel_fps)"/>
    <arg name="unite_imu_method" value="linear_interpolation"/>
  </include>
</launch>
