<?xml version="1.0"?>
<sdf version="1.6">
  <world name="eye_in_hand_visual_servo">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- At zero pose the camera is approximately (0.04,-0.40,0.84) and
         looks along world -Y, so the primary target is visible at startup. -->
    <model name="target_wall">
      <static>true</static>
      <pose>0.04 -1.02 0.84 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>1.20 0.04 1.10</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.20 0.04 1.10</size></box></geometry>
          <material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="red_visual_target">
      <static>true</static><pose>0.04 -0.985 0.84 1.57079632679 0 0</pose>
      <link name="target_link">
        <collision name="collision"><geometry><cylinder><radius>0.075</radius><length>0.025</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.075</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.85 0.01 0.01 1</ambient><diffuse>1 0.01 0.01 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="green_visual_target">
      <static>true</static><pose>-0.22 -0.985 0.62 0 0 0</pose>
      <link name="target_link"><visual name="visual">
        <geometry><sphere><radius>0.055</radius></sphere></geometry>
        <material><ambient>0.01 0.75 0.01 1</ambient><diffuse>0.01 1 0.01 1</diffuse></material>
      </visual></link>
    </model>
    <model name="blue_visual_target">
      <static>true</static><pose>0.30 -0.985 1.05 0 0 0</pose>
      <link name="target_link"><visual name="visual">
        <geometry><box><size>0.10 0.025 0.10</size></box></geometry>
        <material><ambient>0.01 0.01 0.75 1</ambient><diffuse>0.01 0.01 1 1</diffuse></material>
      </visual></link>
    </model>

    <!-- Kept away from the startup arm pose; useful as a depth background. -->
    <model name="workbench">
      <static>true</static><pose>0.62 0.30 0.15 0 0 0</pose>
      <link name="bench_link">
        <collision name="collision"><geometry><box><size>0.65 0.75 0.30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.65 0.75 0.30</size></box></geometry>
          <material><ambient>0.25 0.27 0.30 1</ambient><diffuse>0.35 0.37 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>

    <physics name="visual_servo_physics" type="ode">
      <max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate>
      <ode><solver><type>quick</type><iters>100</iters><sor>1.2</sor></solver></ode>
    </physics>
  </world>
</sdf>
