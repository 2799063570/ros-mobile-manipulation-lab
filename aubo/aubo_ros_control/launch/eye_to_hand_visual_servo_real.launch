<?xml version="1.0"?>
<launch>
  <!-- 眼在手外视觉伺服真机入口：固定相机感知，AUBO SDK 直接控制机械臂。 -->
  <!-- 首次调试保持 auto_start=false，并确认相机外参和 target_offset 方向。 -->
  <arg name="robot_ip" default="192.168.1.2"/>
  <arg name="camera_serial_no" default=""/>
  <arg name="start_camera" default="true"/>
  <arg name="start_perception" default="true"/>
  <arg name="target_label" default="red"/>
  <arg name="auto_start" default="false"/>

  <!-- 使用无腕部相机的模型，防止外部相机模式下误启动手部传感器和重复话题。 -->
  <include file="$(find aubo_moveit_config)/launch/planning_context.launch">
    <arg name="load_robot_description" value="true"/>
    <arg name="robot_xacro" value="aubo_i5.xacro"/>
    <arg name="robot_srdf" value="aubo_i5.srdf"/>
  </include>
  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen"/>

  <!-- 固定相机入口同时负责 RealSense 数据和已标定静态 TF。 -->
  <include if="$(arg start_camera)"
           file="$(find aubo_ros_control)/launch/eye_to_hand_camera_real.launch">
    <arg name="serial_no" value="$(arg camera_serial_no)"/>
  </include>
  <!-- 感知模块可单独关闭，以便接入其他兼容 /visual_servo/target_pose 的检测器。 -->
  <node if="$(arg start_perception)" name="rgbd_visual_target"
        pkg="aubo_perception" type="rgbd_visual_target_node.py" output="screen">
    <rosparam file="$(find aubo_perception)/config/rgbd_target_eye_to_hand.yaml"
              command="load"/>
    <param name="target_label" value="$(arg target_label)"/>
    <param name="start_enabled" value="$(arg auto_start)"/>
  </node>
  <!-- SDK 后端会独占机械臂控制通道，不能同时运行 aubo_hw_node。 -->
  <include file="$(find aubo_ros_control)/launch/visual_servo_core.launch">
    <arg name="mode_config"
         value="$(find aubo_ros_control)/config/visual_servo_eye_to_hand.yaml"/>
    <arg name="backend" value="sdk"/>
    <arg name="robot_ip" value="$(arg robot_ip)"/>
    <arg name="start_enabled" value="$(arg auto_start)"/>
  </include>
</launch>
