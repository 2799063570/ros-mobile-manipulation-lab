<?xml version="1.0"?>
<launch>
  <!-- Eye-in-hand real-robot entry. -->
  <arg name="robot_ip" default="192.168.1.2"/>
  <arg name="target_topic" default="/visual_servo/target_pose"/>
  <arg name="loss_strategy" default="coast_then_open"/>
  <arg name="load_robot_description" default="true"/>
  <arg name="start_realsense" default="true"/>
  <arg name="start_perception" default="true"/>
  <arg name="target_label" default="red"/>
  <arg name="auto_start" default="false"/>

  <include if="$(arg start_realsense)"
           file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="enable_color" value="true"/>
    <arg name="enable_depth" value="true"/>
    <arg name="align_depth" value="true"/>
    <!-- Robot URDF owns the eye-in-hand TF tree and calibrated mount. -->
    <arg name="publish_tf" value="false"/>
  </include>

  <include if="$(arg load_robot_description)"
           file="$(find aubo_moveit_config)/launch/planning_context.launch">
    <arg name="load_robot_description" value="true"/>
    <arg name="robot_xacro" value="aubo_i5_with_camera.xacro"/>
    <arg name="robot_srdf" value="aubo_i5_with_camera.srdf"/>
  </include>
  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen"/>

  <!-- No controller_manager and no ros_control hardware node in real mode. -->
  <include file="$(find aubo_ros_control)/launch/visual_servo_core.launch">
    <arg name="mode_config"
         value="$(find aubo_ros_control)/config/visual_servo_eye_in_hand.yaml"/>
    <arg name="backend" value="sdk"/>
    <arg name="robot_ip" value="$(arg robot_ip)"/>
    <arg name="target_topic" value="$(arg target_topic)"/>
    <arg name="joint_states_topic" value="/joint_states"/>
    <arg name="loss_strategy" value="$(arg loss_strategy)"/>
    <arg name="start_enabled" value="$(arg auto_start)"/>
  </include>

  <node if="$(arg start_perception)" name="rgbd_visual_target"
        pkg="aubo_perception" type="rgbd_visual_target_node.py" output="screen">
    <rosparam file="$(find aubo_perception)/config/rgbd_target_eye_in_hand.yaml"
              command="load"/>
    <param name="target_label" value="$(arg target_label)"/>
    <param name="target_pose_topic" value="$(arg target_topic)"/>
    <param name="start_enabled" value="$(arg auto_start)"/>
  </node>
</launch>
