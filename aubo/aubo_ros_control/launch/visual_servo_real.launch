<?xml version="1.0"?>
<launch>
  <arg name="robot_ip" default="192.168.1.2"/>
  <arg name="target_topic" default="/visual_servo/target_pose"/>
  <arg name="loss_strategy" default="coast_then_open"/>
  <arg name="load_robot_description" default="true"/>

  <include if="$(arg load_robot_description)"
           file="$(find aubo_moveit_config)/launch/planning_context.launch">
    <arg name="load_robot_description" value="true"/>
    <arg name="robot_xacro" value="aubo_i5_with_camera.xacro"/>
    <arg name="robot_srdf" value="aubo_i5_with_camera.srdf"/>
  </include>
  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen"/>

  <!-- No controller_manager and no ros_control hardware node in real mode. -->
  <node name="eye_in_hand_visual_servo" pkg="aubo_ros_control"
        type="eye_in_hand_visual_servo_node" output="screen" required="true">
    <env name="LD_LIBRARY_PATH"
         value="$(find aubo_sdk)/lib/lib64/aubocontroller:$(find aubo_sdk)/lib/lib64/log4cplus:$(find aubo_sdk)/lib/lib64/config:$(optenv LD_LIBRARY_PATH)"/>
    <rosparam file="$(find aubo_ros_control)/config/eye_in_hand_visual_servo.yaml"
              command="load"/>
    <param name="backend" value="sdk"/>
    <param name="robot_ip" value="$(arg robot_ip)"/>
    <param name="target_topic" value="$(arg target_topic)"/>
    <param name="joint_states_topic" value="/joint_states"/>
    <param name="loss_strategy" value="$(arg loss_strategy)"/>
  </node>
</launch>
