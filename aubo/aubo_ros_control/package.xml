<?xml version="1.0"?>
<package format="2">
  <name>aubo_ros_control</name>
  <version>1.0.0</version>
  <description>AUBO ros_control hardware interface and unified eye-in-hand/eye-to-hand visual servo.</description>
  <maintainer email="wheeltec@example.com">WHEELTEC</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>aubo_sdk</depend>
  <depend>controller_manager</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>kdl_parser</depend>
  <depend>pluginlib</depend>
  <depend>orocos_kdl</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>roslib</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>rviz</depend>
  <build_depend>qtbase5-dev</build_depend>
  <exec_depend>joint_state_controller</exec_depend>
  <exec_depend>aubo_perception</exec_depend>
  <exec_depend>image_view</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_control</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>aubo_description</exec_depend>
  <exec_depend>aubo_gazebo</exec_depend>
  <exec_depend>aubo_moveit_config</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>xacro</exec_depend>
  <export>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
