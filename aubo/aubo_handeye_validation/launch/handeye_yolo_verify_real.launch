<?xml version="1.0"?>
<launch>
  <!-- Dedicated low-speed verification: no sorting task and no gripper commands. -->
  <arg name="robot_ip" default="192.168.1.2"/>
  <arg name="camera_serial_no" default=""/>
  <arg name="calibration_file" default="$(find aubo_ros_control)/config/aubo_realsense_handeye_eye_on_base.yaml"/>
  <!-- /camera matches the optical frame saved in the supplied calibration YAML. -->
  <arg name="camera_namespace" default="/camera"/>
  <arg name="target_class" default="can"/>
  <arg name="table_z" default="0.10"/>
  <arg name="table_center_x" default="0.70"/>
  <arg name="table_center_y" default="0.0"/>
  <arg name="table_size_x" default="0.70"/>
  <arg name="table_size_y" default="1.00"/>
  <arg name="table_thickness" default="0.20"/>
  <arg name="object_height" default="0.05"/>
  <arg name="height_mode" default="depth"/>
  <arg name="hover_clearance" default="0.10"/>
  <arg name="travel_clearance" default="0.20"/>
  <arg name="velocity_scaling" default="0.03"/>
  <arg name="acceleration_scaling" default="0.02"/>
  <arg name="start_camera" default="true"/>
  <arg name="start_perception" default="true"/>
  <arg name="start_gripper" default="false"/>
  <arg name="gripper_port" default="/dev/ttyUSB0"/>
  <arg name="rviz" default="true"/>
  <arg name="python" default="/home/zlab/anaconda3/envs/yolo/bin/python"/>
  <arg name="model_path" default="/home/zlab/deepL/code/ultralytics-main-modify/weights/GC-yolo.pt"/>
  <arg name="verification_config" default="$(find aubo_handeye_validation)/config/handeye_yolo_verify.yaml"/>
  <arg name="perception_config" default="$(find aubo_perception)/config/grasp_pipeline.yaml"/>

  <include file="$(find aubo_ros_control)/launch/aubo_real_bringup.launch">
    <arg name="robot_ip" value="$(arg robot_ip)"/>
    <arg name="use_rviz" value="$(arg rviz)"/>
    <arg name="robot_xacro" value="aubo_i5.xacro"/>
    <arg name="robot_srdf" value="aubo_i5.srdf"/>
  </include>
  <include if="$(arg start_camera)" file="$(find aubo_ros_control)/launch/eye_to_hand_camera_real.launch">
    <arg name="serial_no" value="$(arg camera_serial_no)"/>
    <arg name="camera_name" value="$(eval arg('camera_namespace').strip('/'))"/>
    <arg name="calibration_file" value="$(arg calibration_file)"/>
  </include>
  <include if="$(arg start_gripper)" file="$(find inspire_gripper)/launch/gripper_control.launch">
    <arg name="port" value="$(arg gripper_port)"/>
  </include>
  <include if="$(arg start_perception)" file="$(find aubo_perception)/launch/grasp_perception.launch">
    <arg name="camera_mount" value="eye_to_hand"/>
    <arg name="camera_namespace" value="$(arg camera_namespace)"/>
    <arg name="detector" value="yolo"/>
    <arg name="task_mode" value="sorting"/>
    <arg name="table_z" value="$(arg table_z)"/>
    <arg name="object_height" value="$(arg object_height)"/>
    <arg name="height_mode" value="$(arg height_mode)"/>
    <arg name="python" value="$(arg python)"/>
    <arg name="model_path" value="$(arg model_path)"/>
    <arg name="config" value="$(arg perception_config)"/>
  </include>

  <!-- Include the known table in MoveIt's collision world even with sorting disabled. -->
  <node pkg="aubo_ros_control" type="hybrid_planning_scene.py" name="handeye_verify_table" output="screen">
    <param name="table_frame" value="base_link"/>
    <rosparam param="table_center" subst_value="true">[$(arg table_center_x), $(arg table_center_y), $(eval float(arg('table_z')) - float(arg('table_thickness')) / 2)]</rosparam>
    <rosparam param="table_size" subst_value="true">[$(arg table_size_x), $(arg table_size_y), $(arg table_thickness)]</rosparam>
    <param name="table_top_margin" value="0.01"/>
  </node>
  <node pkg="aubo_handeye_validation" type="handeye_yolo_verify.py" name="handeye_yolo_verify" output="screen" required="true">
    <rosparam command="load" file="$(arg verification_config)"/>
    <param name="calibration_file" value="$(arg calibration_file)"/>
    <param name="target_class" value="$(arg target_class)"/>
    <param name="height_mode" value="$(arg height_mode)"/>
    <param name="table_z" value="$(arg table_z)"/>
    <param name="hover_clearance" value="$(arg hover_clearance)"/>
    <param name="travel_clearance" value="$(arg travel_clearance)"/>
    <param name="velocity_scaling" value="$(arg velocity_scaling)"/>
    <param name="acceleration_scaling" value="$(arg acceleration_scaling)"/>
  </node>
</launch>
