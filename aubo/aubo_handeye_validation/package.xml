<?xml version="1.0"?>
<package format="2">
  <name>aubo_handeye_validation</name>
  <version>0.1.0</version>
  <description>Eye-on-base hand-eye consistency evaluation and slow YOLO-guided motion verification.</description>
  <maintainer email="wheeltec@example.com">WHEELTEC</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>rviz</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>std_srvs</build_depend>

  <exec_depend>aubo_ros_control</exec_depend>
  <exec_depend>aubo_perception</exec_depend>
  <exec_depend>aubo_moveit_config</exec_depend>
  <exec_depend>inspire_gripper</exec_depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_commander</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>rviz</exec_depend>

  <export>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>

  <test_depend>python3-nose</test_depend>
  <test_depend>roslaunch</test_depend>
</package>
