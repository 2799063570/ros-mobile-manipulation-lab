<?xml version="1.0"?>
<package format="2">
  <name>aubo_sorting_rqt</name>
  <version>0.1.0</version>
  <description>rqt sorting process, instance queue, controls and online tuning.</description>
  <maintainer email="wheeltec@example.com">WHEELTEC</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>aubo_sorting_core</exec_depend>
  <exec_depend>aubo_ros_control</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>dynamic_reconfigure</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rosservice</exec_depend>
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>rqt_gui_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <test_depend>python3-nose</test_depend>
  <export><rqt_gui plugin="${prefix}/plugin.xml"/></export>
