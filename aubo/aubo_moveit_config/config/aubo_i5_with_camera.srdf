<?xml version="1.0" ?>
<robot name="aubo_i5">
    <group name="aubo_i5">
        <chain base_link="base_link" tip_link="tcp_link" />
    </group>
    <group name="gripper">
        <link name="gripper_link" />
        <joint name="joint1" />
        <joint name="joint2" />
    </group>
    <group_state name="zero" group="aubo_i5">
        <joint name="foreArm_joint" value="0" />
        <joint name="shoulder_joint" value="0" />
        <joint name="upperArm_joint" value="0" />
        <joint name="wrist1_joint" value="0" />
        <joint name="wrist2_joint" value="0" />
        <joint name="wrist3_joint" value="0" />
    </group_state>
    <group_state name="home" group="aubo_i5">
        <joint name="foreArm_joint" value="1.6292" />
        <joint name="shoulder_joint" value="0" />
        <joint name="upperArm_joint" value="0" />
        <joint name="wrist1_joint" value="0" />
        <joint name="wrist2_joint" value="1.6628" />
        <joint name="wrist3_joint" value="0" />
    </group_state>
    <group_state name="open" group="gripper">
        <joint name="joint1" value="0.0" />
        <joint name="joint2" value="0.0" />
    </group_state>
    <group_state name="closed" group="gripper">
        <joint name="joint1" value="0.45" />
        <joint name="joint2" value="0.45" />
    </group_state>
    <end_effector name="aubo_gripper" parent_link="gripper_base_link" group="gripper" parent_group="aubo_i5" />
    <disable_collisions link1="Link1" link2="Link2" reason="Never" />
    <disable_collisions link1="Link1" link2="gripper_base_link" reason="Adjacent" />
    <disable_collisions link1="Link1" link2="wrist1_Link" reason="Never" />
    <disable_collisions link1="Link1" link2="wrist2_Link" reason="Never" />
    <disable_collisions link1="Link1" link2="wrist3_Link" reason="Never" />
    <disable_collisions link1="Link2" link2="gripper_base_link" reason="Adjacent" />
    <disable_collisions link1="Link2" link2="wrist1_Link" reason="Never" />
    <disable_collisions link1="Link2" link2="wrist2_Link" reason="Never" />
    <disable_collisions link1="Link2" link2="wrist3_Link" reason="Never" />
    <disable_collisions link1="base_link" link2="shoulder_Link" reason="Adjacent" />
    <disable_collisions link1="base_link" link2="upperArm_Link" reason="Never" />
    <disable_collisions link1="foreArm_Link" link2="upperArm_Link" reason="Adjacent" />
    <disable_collisions link1="foreArm_Link" link2="wrist1_Link" reason="Adjacent" />
    <disable_collisions link1="gripper_base_link" link2="wrist1_Link" reason="Never" />
    <disable_collisions link1="gripper_base_link" link2="wrist2_Link" reason="Never" />
    <disable_collisions link1="gripper_base_link" link2="wrist3_Link" reason="Adjacent" />
    <disable_collisions link1="gripper_base_link" link2="hand_camera_link" reason="Never" />
    <disable_collisions link1="gripper_base_link" link2="hand_camera_mount_link" reason="Adjacent" />
    <disable_collisions link1="hand_camera_link" link2="hand_camera_mount_link" reason="Adjacent" />
    <disable_collisions link1="hand_camera_link" link2="wrist1_Link" reason="Never" />
    <disable_collisions link1="hand_camera_link" link2="wrist2_Link" reason="Never" />
    <disable_collisions link1="hand_camera_link" link2="wrist3_Link" reason="Never" />
    <disable_collisions link1="hand_camera_mount_link" link2="wrist1_Link" reason="Never" />
    <disable_collisions link1="hand_camera_mount_link" link2="wrist2_Link" reason="Never" />
    <disable_collisions link1="hand_camera_mount_link" link2="wrist3_Link" reason="Never" />
    <disable_collisions link1="shoulder_Link" link2="upperArm_Link" reason="Adjacent" />
    <disable_collisions link1="shoulder_Link" link2="wrist1_Link" reason="Never" />
    <disable_collisions link1="wrist1_Link" link2="wrist2_Link" reason="Adjacent" />
    <disable_collisions link1="wrist1_Link" link2="wrist3_Link" reason="Never" />
    <disable_collisions link1="wrist2_Link" link2="wrist3_Link" reason="Adjacent" />
</robot>

