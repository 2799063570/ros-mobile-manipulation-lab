<?xml version="1.0"?>
<robot name="aubo_i5" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="M_PI" value="3.141592653589793"/>
  <xacro:arg name="camera_horizontal_fov" default="1.3962634016"/>
  <xacro:arg name="camera_lateral_offset" default="0.060"/>
  <xacro:arg name="camera_mount_z_shift" default="0.0"/>
  <xacro:arg name="camera_clip_near" default="0.05"/>
  <xacro:arg name="camera_pointcloud_cutoff" default="0.08"/>

  <xacro:include filename="$(find aubo_description)/urdf/jiazhua.urdf"/>
  <xacro:include filename="$(find aubo_description)/urdf/arm.xacro"/>
  <xacro:include filename="$(find aubo_description)/urdf/hand_camera.xacro"/>

  <joint name="ee_link_joint" type="fixed">
    <parent link="wrist3_Link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:aubo_hand_camera parent_link="gripper_base_link"
      horizontal_fov="$(arg camera_horizontal_fov)"
      lateral_offset="$(arg camera_lateral_offset)"
      mount_z_shift="$(arg camera_mount_z_shift)"
      clip_near="$(arg camera_clip_near)"
      pointcloud_cutoff="$(arg camera_pointcloud_cutoff)"/>
</robot>
