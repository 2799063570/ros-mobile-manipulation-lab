<?xml version="1.0"?>
<robot name="aubo_i5" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="M_PI" value="3.141592653589793"/>

  <xacro:include filename="$(find aubo_description)/urdf/jiazhua.urdf"/>
  <xacro:include filename="$(find aubo_description)/urdf/arm.xacro"/>
  <xacro:include filename="$(find aubo_description)/urdf/hand_camera.xacro"/>

  <joint name="ee_link_joint" type="fixed">
    <parent link="wrist3_Link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:aubo_hand_camera parent_link="gripper_base_link"/>
</robot>
