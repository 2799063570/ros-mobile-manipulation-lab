<launch>
  <!-- Existing robot, move_group, RGB-D and calibrated TF must already be running. -->
  <arg name="condition" doc="S1 | S2 | S3 | S4"/>
  <arg name="run_id"/>
  <arg name="scene_id"/>
  <arg name="model_path" doc="Baseline weights for S1/S3, GC-YOLO weights for S2/S4"/>
  <arg name="output_dir"/>
  <arg name="checkpoint_path" default=""/>
  <arg name="camera_mount" default="eye_to_hand"/>
  <arg name="camera_namespace" default="$(eval '/camera' if arg('camera_mount') == 'eye_in_hand' else '/workspace_camera')"/>
  <arg name="height_mode" default="depth"/>
  <arg name="table_z" default="0.10"/>
  <arg name="object_height" default="0.05"/>
  <arg name="use_detected_angle" default="true"/>
  <arg name="use_detected_width" default="false"/>
  <arg name="task_config" default="$(find aubo_sorting)/config/yolo_sorting.yaml"/>
  <arg name="python" default="/home/zlab/anaconda3/envs/yolo/bin/python"/>
  <arg name="planner_python" default="python3"/>
  <arg name="seed" default="42"/>
  <arg name="use_grasp_attachment" default="false" doc="true only with the Gazebo attach plugin"/>
  <arg name="gripper_backend" default="trajectory" doc="trajectory for Gazebo; inspire for existing physical driver"/>
  <arg name="start_neural_backend" default="true"/>
  <arg name="nsg" value="$(eval {'S1':False,'S2':False,'S3':True,'S4':True}[arg('condition')])"/>
  <node pkg="aubo_thesis_experiments" type="audit_trajectory_node" name="thesis_trajectory_auditor" output="screen" required="true"/>
  <group if="$(arg nsg)">
    <node if="$(arg start_neural_backend)" pkg="motion_planning" type="ros_planner_node.py"
          name="thesis_neural_planner" launch-prefix="$(arg planner_python)" output="screen" required="true">
      <param name="strict_runtime" value="true"/>
      <param name="checkpoint_path" value="$(arg checkpoint_path)"/>
      <param name="max_time" value="5.0"/>
      <param name="max_iter" value="800"/>
      <param name="seed" value="$(arg seed)"/>
    </node>
    <node pkg="aubo_thesis_experiments" type="nsg_moveit_adapter.py" name="thesis_nsg_adapter" output="screen" required="true">
      <param name="output_dir" value="$(arg output_dir)_nsg"/>
    </node>
  </group>
  <include file="$(find aubo_sorting)/launch/sorting.launch">
    <arg name="detector" value="yolo"/>
    <arg name="camera_mount" value="$(arg camera_mount)"/>
    <arg name="camera_namespace" value="$(arg camera_namespace)"/>
    <arg name="height_mode" value="$(arg height_mode)"/>
    <arg name="table_z" value="$(arg table_z)"/>
    <arg name="object_height" value="$(arg object_height)"/>
    <arg name="use_detected_angle" value="$(arg use_detected_angle)"/>
    <arg name="use_detected_width" value="$(arg use_detected_width)"/>
    <arg name="task_config" value="$(arg task_config)"/>
    <arg name="model_path" value="$(arg model_path)"/>
    <arg name="python" value="$(arg python)"/>
    <arg name="auto_start" value="false"/>
    <arg name="auto_move_to_observation" value="false"/>
    <arg name="use_grasp_attachment" value="$(arg use_grasp_attachment)"/>
    <arg name="gripper_backend" value="$(arg gripper_backend)"/>
    <arg name="experiment_enabled" value="true"/>
    <arg name="experiment_run_id" value="$(arg run_id)"/>
    <arg name="experiment_scene_id" value="$(arg scene_id)"/>
    <arg name="experiment_condition" value="$(arg condition)"/>
    <arg name="planner_id" value="$(eval '' if arg('condition') in ['S3','S4'] else 'RRTConnectkConfigDefault')"/>
    <arg name="planning_service" value="$(eval '/thesis_experiment/nsg_plan' if arg('condition') in ['S3','S4'] else '')"/>
    <arg name="revalidate_trajectories" value="true"/>
  </include>
  <node pkg="aubo_thesis_experiments" type="record_experiment.py" name="thesis_experiment_recorder" output="screen" required="true">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="camera_info_topic" value="$(arg camera_namespace)/color/camera_info"/>
    <rosparam param="metadata" subst_value="true">{run_id: '$(arg run_id)', scene_id: '$(arg scene_id)', condition: '$(arg condition)', run_seed: $(arg seed), model_path: '$(arg model_path)', checkpoint_path: '$(arg checkpoint_path)'}</rosparam>
    <rosparam param="hash_files" subst_value="true">['$(arg model_path)']</rosparam>
  </node>
</launch>
