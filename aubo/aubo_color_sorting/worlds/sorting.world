<?xml version="1.0"?>
<sdf version="1.6">
  <world name="aubo_color_sorting">
    <!-- Contact-assisted grasping for small blocks. -->
    <plugin name="aubo_grasp_attach"
            filename="libaubo_grasp_attach_plugin.so">
      <robot_model>aubo_i5</robot_model>
      <!-- wrist3_Link is guaranteed to survive URDF fixed-joint lumping; the
           fixed gripper base has the same pose in this model. -->
      <palm_link>wrist3_Link</palm_link>
      <object_link>block_link</object_link>
      <max_attach_distance>0.18</max_attach_distance>
      <attach_topic>/sorting/grasp/attach</attach_topic>
      <detach_topic>/sorting/grasp/detach</detach_topic>
      <status_topic>/sorting/grasp/status</status_topic>
    </plugin>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Shared fixed RGB-D camera for eye-to-hand visual servo. The sorting
         and eye-in-hand nodes ignore these topics; keeping the sensor in this
         common world lets both servo modes use exactly the same workcell. -->
    <model name="workspace_camera">
      <static>true</static>
      <pose>0.55 0 1.60 0 1.57079632679 0</pose>
      <link name="workspace_camera_link">
        <collision name="camera_body_collision"><geometry><box><size>0.09 0.03 0.03</size></box></geometry></collision>
        <visual name="camera_body_visual">
          <geometry><box><size>0.09 0.03 0.03</size></box></geometry>
          <material><ambient>0.20 0.22 0.25 1</ambient><diffuse>0.35 0.38 0.42 1</diffuse></material>
        </visual>
        <sensor type="depth" name="workspace_camera_rgbd">
          <pose>0.045 0 0 0 0 0</pose>
          <always_on>true</always_on><visualize>false</visualize><update_rate>20</update_rate>
          <camera name="workspace_camera_sensor">
            <horizontal_fov>1.0471975512</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.15</near><far>3.0</far></clip>
          </camera>
          <plugin name="workspace_camera_gazebo_ros_openni" filename="libgazebo_ros_openni_kinect.so">
            <cameraName>workspace_camera</cameraName>
            <imageTopicName>color/image_raw</imageTopicName>
            <cameraInfoTopicName>color/camera_info</cameraInfoTopicName>
            <depthImageTopicName>aligned_depth_to_color/image_raw</depthImageTopicName>
            <depthImageCameraInfoTopicName>aligned_depth_to_color/camera_info</depthImageCameraInfoTopicName>
            <pointCloudTopicName>depth/color/points</pointCloudTopicName>
            <frameName>workspace_camera_color_optical_frame</frameName>
            <pointCloudCutoff>0.15</pointCloudCutoff><pointCloudCutoffMax>3.0</pointCloudCutoffMax>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Fixed-base AUBO: base_link is at world z=0.  The deliberately low
         table top is therefore z=0.10 in both world and base_link. -->
    <model name="sorting_table">
      <static>true</static>
      <pose>0.70 0 0.0 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry><box><size>0.70 1.00 0.20</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.70 1.00 0.20</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.47 1</ambient>
            <diffuse>0.55 0.55 0.57 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="red_block">
      <pose>0.54 -0.12 0.120 0 0 0</pose>
      <link name="block_link">
        <gravity>true</gravity>
        <kinematic>false</kinematic>
        <inertial><mass>0.04</mass><inertia><ixx>0.000011</ixx><iyy>0.000011</iyy><izz>0.000011</izz></inertia></inertial>
        <collision name="collision">
          <max_contacts>20</max_contacts>
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>20.0</mu><mu2>20.0</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.8 0.02 0.02 1</ambient><diffuse>1 0.02 0.02 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="green_block">
      <pose>0.64 0 0.120 0 0 0</pose>
      <link name="block_link">
        <gravity>true</gravity>
        <kinematic>false</kinematic>
        <inertial><mass>0.04</mass><inertia><ixx>0.000011</ixx><iyy>0.000011</iyy><izz>0.000011</izz></inertia></inertial>
        <collision name="collision">
          <max_contacts>20</max_contacts>
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>20.0</mu><mu2>20.0</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.02 0.8 0.02 1</ambient><diffuse>0.02 1 0.02 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_block">
      <pose>0.54 0.12 0.120 0 0 0</pose>
      <link name="block_link">
        <gravity>true</gravity>
        <kinematic>false</kinematic>
        <inertial><mass>0.04</mass><inertia><ixx>0.000011</ixx><iyy>0.000011</iyy><izz>0.000011</izz></inertia></inertial>
        <collision name="collision">
          <max_contacts>20</max_contacts>
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>20.0</mu><mu2>20.0</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.02 0.02 0.8 1</ambient><diffuse>0.02 0.02 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <physics name="sorting_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode><solver><type>quick</type><iters>150</iters><sor>1.3</sor></solver></ode>
    </physics>
  </world>
</sdf>
