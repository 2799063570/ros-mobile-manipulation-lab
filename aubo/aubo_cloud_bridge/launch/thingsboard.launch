<launch>
  <arg name="host" default="$(optenv THINGSBOARD_HOST mqtt.thingsboard.cloud)"/>
  <arg name="token_file" default="$(env HOME)/.config/aubo/thingsboard.token"/>
  <arg name="enable_commands" default="false"/>
  <arg name="sorting_ns" default="/sorting"/>
  <node pkg="aubo_cloud_bridge" type="thingsboard_bridge" name="aubo_cloud_bridge" output="screen" required="false">
    <rosparam command="load" file="$(find aubo_cloud_bridge)/config/thingsboard.yaml"/>
    <param name="host" value="$(arg host)"/>
    <param name="token_file" value="$(arg token_file)"/>
    <param name="enable_commands" value="$(arg enable_commands)"/>
    <param name="sorting_ns" value="$(arg sorting_ns)"/>
  </node>
</launch>
