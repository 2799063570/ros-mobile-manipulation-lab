<?xml version="1.0"?>
<package format="2">
  <name>aubo_remote_bridge</name>
  <version>0.2.0</version>
  <description>C++ serial remote bridge and isolated Gazebo named-pose validation for AUBO i5.</description>
  <maintainer email="maintainer@example.com">AUBO remote developers</maintainer>
