<launch>
  <!-- 使用真实点动节点和满秩合成模型；串口由测试创建PTY，完全不连接实机。 -->
  <param name="robot_description" textfile="$(find aubo_ros_control)/test/jog_test.urdf"/>
  <param name="robot_description_semantic" value="&lt;robot name='jog_test'&gt;&lt;group name='aubo_i5'&gt;&lt;chain base_link='base_link' tip_link='tcp_link'/&gt;&lt;/group&gt;&lt;/robot&gt;"/>
  <node pkg="aubo_ros_control" type="aubo_cartesian_jog_node" name="aubo_cartesian_jog" required="true">
    <rosparam file="$(find aubo_ros_control)/config/cartesian_jog.yaml"/>
    <param name="backend" value="gazebo"/>
    <rosparam param="home_joint_positions">[0.12, 0, 0, 0, 0, 0]</rosparam>
    <rosparam param="joint_lower_limits">[-2.5, -2.5, -2.5, -2.5, -2.5, -2.5]</rosparam>
    <rosparam param="joint_upper_limits">[2.5, 2.5, 2.5, 2.5, 2.5, 2.5]</rosparam>
    <rosparam param="gazebo_command_topics">[/remote_test/q0, /remote_test/q1, /remote_test/q2, /remote_test/q3, /remote_test/q4, /remote_test/q5]</rosparam>
  </node>
  <test test-name="cartesian_serial" pkg="aubo_remote_bridge" type="cartesian_serial_test.py" time-limit="90"/>
</launch>
