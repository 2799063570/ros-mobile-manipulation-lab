#!/usr/bin/env python3
"""Huawei IoTDA telemetry and allowlisted ROS tasks with a persisted report budget."""
import collections
import os
from pathlib import Path
import re
import ssl
import threading
import time
import uuid

import paho.mqtt.client as mqtt
import rosgraph
import rospy
from std_msgs.msg import String
from std_srvs.srv import Trigger
from aubo_cloud_bridge.commands import Dispatcher
from aubo_cloud_bridge.protocol import CommandJournal, METHODS, decode_json, encode_json
from aubo_huawei_bridge.telemetry import HuaweiTelemetry
from aubo_huawei_bridge.budget import PublishBudget
from aubo_huawei_bridge.iot import (credentials, topics, request_id, decode_command,
                                    property_report, command_reply, result_summary)


class Bridge:
    def __init__(self):
        self.lock = threading.Lock()
        self.shutdown = threading.Event()
        self.session = ''
        self.available = False
        self.health_checked = 0.0
        self.last_command = {}
        self.last_report_ms = 0
        self.reply_permits = collections.Counter()
        self.telemetry = HuaweiTelemetry()
        self.ns = rospy.get_param('~sorting_ns', '/sorting').rstrip('/')
        self.enabled = rospy.get_param('~enable_commands', False)
        self.extended = rospy.get_param('~extended_telemetry', False)
        self.task_node = rospy.get_param('~task_node', '/color_sorting_task').rstrip('/')
        self.interval = float(rospy.get_param('~publish_interval', 30))
        self.service_wait = float(rospy.get_param('~service_wait', 1))
        if type(self.enabled) is not bool or type(self.extended) is not bool or not 5 <= self.interval <= 3600 or not .1 <= self.service_wait <= 2:
            raise ValueError('invalid_bridge_parameters')
        device = decode_json(Path(os.path.expanduser(rospy.get_param('~credentials_file'))).read_text())
        self.device_id = device['device_id']
        client_id, username, password = credentials(self.device_id, device['device_secret'])
        host = device['host']
        if not isinstance(host, str) or not re.fullmatch(r'[A-Za-z0-9.-]+', host):
            raise ValueError('invalid_mqtt_hostname')
        self.topics = topics(self.device_id)
        if hasattr(mqtt, 'CallbackAPIVersion'):
            self.client = mqtt.Client(callback_api_version=mqtt.CallbackAPIVersion.VERSION2,
                client_id=client_id, clean_session=True)
            self.client.on_disconnect = self.on_disconnect_v2
        else:
            self.client = mqtt.Client(client_id=client_id, clean_session=True)
            self.client.on_disconnect = self.on_disconnect_v1
        self.client.username_pw_set(username, password)
        context = ssl.create_default_context(cafile=os.path.expanduser(device['ca_file']) if device.get('ca_file') else None)
        context.minimum_version = ssl.TLSVersion.TLSv1_2
        self.client.tls_set_context(context)
        self.client.max_queued_messages_set(8)
        self.client.max_inflight_messages_set(4)
        self.client.reconnect_delay_set(min_delay=1, max_delay=30)
        self.client.on_connect = self.on_connect
        self.client.on_message = self.on_message
        paths = {key: Path(os.path.expanduser(rospy.get_param('~' + key)))
                 for key in ('journal_path', 'budget_path')}
        for path in paths.values():
            path.parent.mkdir(parents=True, exist_ok=True)
        self.journal = CommandJournal(str(paths['journal_path']))
        self.budget = PublishBudget(str(paths['budget_path']),
            rospy.get_param('~outgoing_units_per_24h', 4000), rospy.get_param('~reply_reserve', 100))
        self.dispatcher = Dispatcher(self.journal, self.execute, self.reply, self.report,
                                     self.context, enabled=self.enabled)
        self.subscribers = [rospy.Subscriber(self.ns + '/' + kind, String, self.ros_message,
            callback_args=kind, queue_size=1) for kind in (
                'state', 'progress', 'failure', 'detection_summary', 'target_cache', 'completed_counts')]
        self.status_publisher = rospy.Publisher('~status', String, queue_size=1, latch=True)
        self.client.connect_async(host, int(rospy.get_param('~port', 8883)),
                                  int(rospy.get_param('~keepalive', 60)))
        self.client.loop_start()

    def on_connect(self, client, userdata, flags, reason_code, properties=None):
        if reason_code != 0:
            self.disconnected()
            rospy.logwarn('Huawei MQTT refused connection; check device identity, secret and endpoint')
            return
        with self.lock:
            self.session = uuid.uuid4().hex
        client.subscribe(self.topics['subscription'], qos=1)
        rospy.loginfo('Huawei IoTDA connected; task commands %s; report interval %.1fs',
                      'enabled' if self.enabled else 'disabled', self.interval)

    def disconnected(self):
        with self.lock:
            self.session = ''

    def on_disconnect_v1(self, client, userdata, rc):
        self.disconnected()

    def on_disconnect_v2(self, client, userdata, flags, reason_code, properties):
        self.disconnected()

    def context(self):
        with self.lock:
            return self.session, (self.available and not self.shutdown.is_set()
                and time.monotonic() - self.health_checked < 5)

    def ros_message(self, message, kind):
        try:
            self.telemetry.update(kind, message.data)
        except (ValueError, TypeError, OverflowError):
            rospy.logwarn_throttle(10, 'Huawei bridge ignored malformed %s', kind)

    def on_message(self, client, userdata, message):
        try:
            token = request_id(message.topic, self.topics['request_prefix'])
        except ValueError:
            return
        # Reserve response capacity before dispatching a task, including on malformed/duplicate requests.
        try:
            allowed = self.budget.take(reply=True)
        except Exception:
            allowed = False
        if not allowed:
            rospy.logwarn_throttle(10, 'Huawei outgoing response budget unavailable; command not dispatched')
            return
        with self.lock:
            self.reply_permits[token] += 1
        try:
            if len(message.payload) > 4096:
                raise ValueError('message_too_large')
            document = decode_command(decode_json(message.payload))
            self.dispatcher.submit(token, document, retained=message.retain)
        except (ValueError, TypeError, UnicodeError):
            self.reply(token, {'status': 'rejected', 'reason': 'malformed_command'})

    def execute(self, method, guard):
        service = self.ns + '/' + method
        rospy.wait_for_service(service, timeout=self.service_wait)
        if not guard():
            return False, 'expired, disconnected or cancelled before ROS call'
        response = rospy.ServiceProxy(service, Trigger)()
        return response.success, response.message

    def reply(self, token, result):
        with self.lock:
            if not self.reply_permits.get(token):
                return
            self.reply_permits[token] -= 1
            if not self.reply_permits[token]:
                del self.reply_permits[token]
        if self.client.is_connected():
            self.client.publish(self.topics['reply_prefix'] + token, encode_json(command_reply(result)),
                                qos=0, retain=False)

    def report(self, result):
        with self.lock:
            self.last_command = result_summary({**result, 'wall_stamp_ms': int(time.time() * 1000)})

    def run(self):
        master = rosgraph.Master(rospy.get_name())
        next_report = 0.0
        while not rospy.is_shutdown() and not self.shutdown.is_set():
            try:
                publishers, _, services = master.getSystemState()
                available = (self.ns + '/state' in {name for name, nodes in publishers if nodes}
                    and all(self.ns + '/' + method in {name for name, nodes in services if nodes} for method in METHODS))
            except Exception:
                available = False
            now, now_ms = time.monotonic(), int(time.time() * 1000)
            try:
                self.telemetry.set_workcell(rospy.get_param(self.task_node + '/table_center', None),
                    rospy.get_param(self.task_node + '/table_size', None),
                    rospy.get_param(self.task_node + '/target_frame', 'base_link'))
            except Exception:
                pass
            with self.lock:
                self.available, self.health_checked = available, now
                session, last = self.session, dict(self.last_command)
            if session and self.client.is_connected() and now >= next_report:
                next_report = now + self.interval
                payload = property_report(self.telemetry.snapshot(), session, available, self.enabled, last, now_ms,
                                          extended=self.extended)
                if self.budget.take():
                    info = self.client.publish(self.topics['report'], encode_json(payload), qos=0, retain=False)
                    if info.rc == mqtt.MQTT_ERR_SUCCESS:
                        self.last_report_ms = now_ms
                    else:
                        rospy.logwarn_throttle(30, 'Huawei property publish failed; sample not queued for retry')
                else:
                    rospy.logwarn_throttle(30, 'Huawei outgoing report budget reached; waiting for rolling quota')
            status = dict(session=session, connected=bool(session), commands_enabled=self.enabled,
                sorting_available=available, device_id=self.device_id, status_wall_ms=now_ms,
                last_report_ms=self.last_report_ms, publish_interval=self.interval,
                outgoing_units_24h=self.budget.used(), outgoing_limit=self.budget.limit,
                extended_telemetry=self.extended)
            self.status_publisher.publish(String(data=encode_json(status)))
            self.shutdown.wait(1)

    def close(self):
        self.shutdown.set()
        self.disconnected()
        self.client.disconnect()
        self.client.loop_stop()


def main():
    rospy.init_node('aubo_huawei_bridge')
    bridge = None
    try:
        bridge = Bridge()
        rospy.on_shutdown(bridge.close)
        bridge.run()
    except Exception as error:
        rospy.logerr('Huawei bridge stopped (%s). Check credentials_file, CA, host and writable journal/budget.',
                     type(error).__name__)
        return 1
    finally:
        if bridge is not None:
            bridge.close()
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
