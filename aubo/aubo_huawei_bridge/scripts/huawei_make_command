#!/usr/bin/env python3
"""Generate a short-lived console command from the live local bridge session; does not send it."""
import argparse
from pathlib import Path
import time

import rospy
from std_msgs.msg import String
from aubo_cloud_bridge.protocol import decode_json
from aubo_huawei_bridge.iot import make_command
import json


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('method', choices=('move_to_observation', 'start', 'stop', 'home'))
    parser.add_argument('--ttl', type=int, default=25, choices=range(1, 31))
    parser.add_argument('--status-topic', default='/aubo_huawei_bridge/status')
    parser.add_argument('--output', type=Path)
    parser.add_argument('--paras-only', action='store_true', help='Print only the console command parameters')
    args = parser.parse_args(rospy.myargv()[1:])
    rospy.init_node('huawei_make_command', anonymous=True)
    try:
        status = decode_json(rospy.wait_for_message(args.status_topic, String, timeout=3).data)
        now_ms = int(time.time() * 1000)
        if not status.get('connected') or abs(now_ms - status.get('status_wall_ms', 0)) > 3000:
            raise ValueError('bridge_offline')
        document = make_command(args.method, status['session'], now_ms, args.ttl)
        text = json.dumps(document['paras'] if args.paras_only else document, ensure_ascii=False, indent=2) + '\n'
        if args.output:
            args.output.write_text(text, encoding='utf-8')
        print(text, end='')
        return 0
    except (ValueError, KeyError, OSError, rospy.ROSException):
        print('Unable to prepare command: check live bridge status and connection.')
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
