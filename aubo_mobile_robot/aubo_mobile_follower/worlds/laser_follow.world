<?xml version="1.0"?>
<sdf version="1.6">
  <world name="aubo_laser_follow">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <gui fullscreen="0">
      <camera name="course_camera">
        <pose>5 -6 5 0 0.6 2.0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Visual-only markings do not create lidar returns or wheel bumps.
         laser_follow.launch spawns the movable follower_target separately,
         preserving target_x/target_y and spawn_test_target overrides. -->
    <model name="start_marker">
      <static>true</static>
      <pose>0 0 0.003 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><cylinder><radius>0.42</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.08 0.20 0.55 1</ambient><diffuse>0.08 0.30 0.85 1</diffuse></material>
      </visual></link>
    </model>
    <model name="distance_ticks">
      <static>true</static>
      <link name="link">
        <visual name="one_metre">
          <pose>1 0 0.004 0 0 0</pose>
          <geometry><box><size>0.025 2 0.008</size></box></geometry>
          <material><ambient>0.8 0.6 0.05 1</ambient><diffuse>1 0.8 0.08 1</diffuse></material>
        </visual>
        <visual name="two_metres">
          <pose>2 0 0.004 0 0 0</pose>
          <geometry><box><size>0.025 2 0.008</size></box></geometry>
          <material><ambient>0.8 0.6 0.05 1</ambient><diffuse>1 0.8 0.08 1</diffuse></material>
        </visual>
        <visual name="three_metres">
          <pose>3 0 0.004 0 0 0</pose>
          <geometry><box><size>0.025 2 0.008</size></box></geometry>
          <material><ambient>0.8 0.6 0.05 1</ambient><diffuse>1 0.8 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>
    <physics name="laser_follow_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode><solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver></ode>
    </physics>
  </world>
</sdf>
