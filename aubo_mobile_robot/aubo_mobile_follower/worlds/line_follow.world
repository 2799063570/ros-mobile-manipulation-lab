<?xml version="1.0"?>
<sdf version="1.6">
  <world name="aubo_line_follow">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- A continuous, gently curving black guide line.  The segments are
         visual-only so the wheels do not encounter artificial bumps. -->
    <model name="guide_line">
      <static>true</static>
      <link name="line_link">
        <visual name="segment_0">
          <pose>0.25 0 0.006 0 0 0</pose>
          <geometry><box><size>1.50 0.10 0.008</size></box></geometry>
          <material><ambient>0.005 0.005 0.005 1</ambient><diffuse>0.01 0.01 0.01 1</diffuse></material>
        </visual>
        <visual name="segment_1">
          <pose>1.48 0.05 0.006 0 0 0.10</pose>
          <geometry><box><size>1.00 0.10 0.008</size></box></geometry>
          <material><ambient>0.005 0.005 0.005 1</ambient><diffuse>0.01 0.01 0.01 1</diffuse></material>
        </visual>
        <visual name="segment_2">
          <pose>2.42 0.27 0.006 0 0 0.35</pose>
          <geometry><box><size>1.00 0.10 0.008</size></box></geometry>
          <material><ambient>0.005 0.005 0.005 1</ambient><diffuse>0.01 0.01 0.01 1</diffuse></material>
        </visual>
        <visual name="segment_3">
          <pose>3.28 0.72 0.006 0 0 0.60</pose>
          <geometry><box><size>1.00 0.10 0.008</size></box></geometry>
          <material><ambient>0.005 0.005 0.005 1</ambient><diffuse>0.01 0.01 0.01 1</diffuse></material>
        </visual>
        <visual name="segment_4">
          <pose>4.00 1.39 0.006 0 0 0.88</pose>
          <geometry><box><size>1.05 0.10 0.008</size></box></geometry>
          <material><ambient>0.005 0.005 0.005 1</ambient><diffuse>0.01 0.01 0.01 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="line_finish_marker">
      <static>true</static><pose>4.38 1.86 0.007 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><cylinder><radius>0.20</radius><length>0.010</length></cylinder></geometry>
        <material><ambient>0.02 0.55 0.05 1</ambient><diffuse>0.02 0.90 0.08 1</diffuse></material>
      </visual></link>
    </model>

    <physics name="line_follow_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode><solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver></ode>
    </physics>
  </world>
</sdf>
