<?xml version="1.0"?>
<launch>
  <!-- Internal reusable entry. Use laser_follow.launch, color_follow.launch or
       line_follow.launch instead of invoking this file directly. -->
  <arg name="follower_type"/>
  <arg name="controller_namespace"/>
  <arg name="arm_target"/>
  <arg name="linear_kp"/>
  <arg name="linear_ki"/>
  <arg name="linear_kd"/>
  <arg name="angular_kp"/>
  <arg name="angular_ki"/>
  <arg name="angular_kd"/>
  <arg name="derivative_filter_alpha"/>
  <arg name="linear_integral_limit"/>
  <arg name="angular_integral_limit"/>
  <arg name="wait_for_camera" default="false"/>
  <arg name="camera_topic" default="/hand_camera/image_raw"/>
  <arg name="move_group_wait_timeout" default="60.0"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="start_robot" default="false"/>
  <arg name="start_moveit" default="true"/>
  <arg name="start_scan_merger" default="true"/>
  <arg name="use_laser_safety" default="true"/>
  <arg name="safe_follower_cmd_vel_topic" default="/cmd_vel_raw"/>
  <arg name="direct_follower_cmd_vel_topic" default="/cmd_vel"/>
  <arg name="world" default="$(find aubo_mobile_robot)/worlds/empty.world"/>
  <arg name="gui" default="true"/>

  <group if="$(arg start_robot)">
    <include file="$(find aubo_mobile_robot)/launch/gazebo.launch">
      <arg name="world" value="$(arg world)"/>
      <arg name="gui" value="$(arg gui)"/>
    </include>
  </group>

  <group if="$(arg start_moveit)">
    <include file="$(find aubo_mobile_moveit_config)/launch/move_group.launch">
      <arg name="allow_trajectory_execution" value="true"/>
      <arg name="fake_execution" value="false"/>
      <arg name="load_robot_description" value="false"/>
    </include>
  </group>

  <group if="$(arg start_scan_merger)">
    <include file="$(find aubo_mobile_navigation)/launch/scan_merger.launch"/>
  </group>

  <node pkg="aubo_mobile_follower" type="prepare_arm_pose.py"
        name="prepare_follower_arm_pose" output="screen">
    <param name="target" value="$(arg arm_target)"/>
    <param name="wait_for_camera" value="$(arg wait_for_camera)"/>
    <param name="camera_topic" value="$(arg camera_topic)"/>
    <param name="move_group_wait_timeout" value="$(arg move_group_wait_timeout)"/>
    <param name="ready_topic" value="/aubo_mobile_follower/arm_ready"/>
  </node>

  <group if="$(arg use_laser_safety)">
    <node pkg="aubo_mobile_follower" type="$(arg follower_type)"
          name="aubo_mobile_follower" output="screen">
      <rosparam file="$(find aubo_mobile_follower)/config/follower.yaml" command="load"/>
      <param name="image_topic" value="$(arg camera_topic)"/>
      <param name="scan_topic" value="$(arg scan_topic)"/>
      <param name="cmd_vel_topic" value="$(arg safe_follower_cmd_vel_topic)"/>
      <param name="$(arg controller_namespace)/linear_kp" value="$(arg linear_kp)"/>
      <param name="$(arg controller_namespace)/linear_ki" value="$(arg linear_ki)"/>
      <param name="$(arg controller_namespace)/linear_kd" value="$(arg linear_kd)"/>
      <param name="$(arg controller_namespace)/angular_kp" value="$(arg angular_kp)"/>
      <param name="$(arg controller_namespace)/angular_ki" value="$(arg angular_ki)"/>
      <param name="$(arg controller_namespace)/angular_kd" value="$(arg angular_kd)"/>
      <param name="$(arg controller_namespace)/derivative_filter_alpha" value="$(arg derivative_filter_alpha)"/>
      <param name="$(arg controller_namespace)/linear_integral_limit" value="$(arg linear_integral_limit)"/>
      <param name="$(arg controller_namespace)/angular_integral_limit" value="$(arg angular_integral_limit)"/>
    </node>
    <include file="$(find aubo_mobile_navigation)/launch/laser_safety_filter.launch">
      <arg name="scan_topic" value="$(arg scan_topic)"/>
      <arg name="input_cmd_vel" value="/cmd_vel_raw"/>
      <arg name="output_cmd_vel" value="/cmd_vel"/>
      <!-- The arm/camera may extend beyond the circular mobile base. -->
      <arg name="robot_half_width" value="0.42"/>
      <arg name="safety_margin" value="0.15"/>
      <arg name="stop_distance" value="0.70"/>
      <arg name="reverse_stop_distance" value="0.45"/>
      <arg name="rotation_clearance" value="0.75"/>
    </include>
  </group>
  <group unless="$(arg use_laser_safety)">
    <node pkg="aubo_mobile_follower" type="$(arg follower_type)"
          name="aubo_mobile_follower" output="screen">
      <rosparam file="$(find aubo_mobile_follower)/config/follower.yaml" command="load"/>
      <param name="image_topic" value="$(arg camera_topic)"/>
      <param name="scan_topic" value="$(arg scan_topic)"/>
      <param name="cmd_vel_topic" value="$(arg direct_follower_cmd_vel_topic)"/>
      <param name="$(arg controller_namespace)/linear_kp" value="$(arg linear_kp)"/>
      <param name="$(arg controller_namespace)/linear_ki" value="$(arg linear_ki)"/>
      <param name="$(arg controller_namespace)/linear_kd" value="$(arg linear_kd)"/>
      <param name="$(arg controller_namespace)/angular_kp" value="$(arg angular_kp)"/>
      <param name="$(arg controller_namespace)/angular_ki" value="$(arg angular_ki)"/>
      <param name="$(arg controller_namespace)/angular_kd" value="$(arg angular_kd)"/>
      <param name="$(arg controller_namespace)/derivative_filter_alpha" value="$(arg derivative_filter_alpha)"/>
      <param name="$(arg controller_namespace)/linear_integral_limit" value="$(arg linear_integral_limit)"/>
      <param name="$(arg controller_namespace)/angular_integral_limit" value="$(arg angular_integral_limit)"/>
    </node>
  </group>
</launch>
