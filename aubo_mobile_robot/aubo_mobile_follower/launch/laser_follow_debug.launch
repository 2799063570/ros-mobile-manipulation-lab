<?xml version="1.0"?>
<launch>
  <arg name="start_robot" default="true"/>
  <arg name="start_moveit" default="true"/>
  <arg name="start_scan_merger" default="true"/>
  <arg name="use_laser_safety" default="true"/>
  <arg name="world" default="$(find aubo_mobile_robot)/worlds/empty.world"/>
  <arg name="gui" default="true"/>
  <arg name="spawn_test_target" default="true"/>
  <arg name="start_rviz" default="true"/>
  <arg name="target_x" default="2.5"/>
  <arg name="target_y" default="0.0"/>

  <include file="$(find aubo_mobile_follower)/launch/laser_follow.launch">
    <arg name="start_robot" value="$(arg start_robot)"/>
    <arg name="start_moveit" value="$(arg start_moveit)"/>
    <arg name="start_scan_merger" value="$(arg start_scan_merger)"/>
    <arg name="use_laser_safety" value="$(arg use_laser_safety)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <!-- A deterministic lidar target avoids Gazebo GUI insertion failures. -->
  <node if="$(arg spawn_test_target)" pkg="gazebo_ros" type="spawn_model"
        name="spawn_follower_test_target" output="screen"
        args="-sdf -file $(find aubo_mobile_follower)/models/laser_target/model.sdf
              -model follower_target -x $(arg target_x) -y $(arg target_y) -z 0.5"/>

  <node if="$(arg spawn_test_target)" pkg="aubo_mobile_follower"
        type="target_interactive_marker.py" name="follower_target_control"
        output="screen">
    <param name="model_name" value="follower_target"/>
    <param name="marker_frame" value="odom"/>
    <param name="target_z" value="0.5"/>
  </node>

  <node if="$(arg start_rviz)" pkg="rviz" type="rviz"
        name="follower_debug_rviz" output="screen"
        args="-d $(find aubo_mobile_follower)/rviz/laser_follow_debug.rviz">
    <!-- OGRE 1.9 is unstable with the installed NVIDIA 580 Open stack.
         This affects RViz only; Gazebo keeps hardware acceleration. -->
    <env name="LIBGL_ALWAYS_SOFTWARE" value="1"/>
    <env name="__GLX_VENDOR_LIBRARY_NAME" value="mesa"/>
    <env name="MESA_LOADER_DRIVER_OVERRIDE" value="llvmpipe"/>
  </node>
</launch>
