<?xml version="1.0"?>
<launch>
  <!-- Standalone task simulation by default.  Set start_robot:=false when
       connecting the follower to an already running robot or Gazebo. -->
  <arg name="start_robot" default="true"/>
  <arg name="start_moveit" default="true"/>
  <arg name="start_scan_merger" default="true"/>
  <arg name="use_laser_safety" default="true"/>
  <arg name="camera_topic" default="/hand_camera/image_raw"/>
  <arg name="move_group_wait_timeout" default="60.0"/>
  <arg name="world" default="$(find aubo_mobile_follower)/worlds/line_follow.world"/>
  <arg name="gui" default="true"/>
  <arg name="start_rviz" default="true"/>
  <arg name="start_rqt_reconfigure" default="false"/>
  <arg name="start_path_trail" default="true"/>
  <arg name="angular_kp" default="0.9"/>
  <arg name="angular_ki" default="0.0"/>
  <arg name="angular_kd" default="0.12"/>
  <arg name="derivative_filter_alpha" default="0.25"/>
  <arg name="angular_integral_limit" default="1.0"/>

  <include file="$(find aubo_mobile_follower)/launch/follower.launch">
    <arg name="follower_type" value="line_follower.py"/>
    <arg name="controller_namespace" value="line"/>
    <!-- Existing named state: hand camera looks down at the guide line. -->
    <arg name="arm_target" value="observe"/>
    <arg name="linear_kp" value="0.0"/>
    <arg name="linear_ki" value="0.0"/>
    <arg name="linear_kd" value="0.0"/>
    <arg name="angular_kp" value="$(arg angular_kp)"/>
    <arg name="angular_ki" value="$(arg angular_ki)"/>
    <arg name="angular_kd" value="$(arg angular_kd)"/>
    <arg name="derivative_filter_alpha" value="$(arg derivative_filter_alpha)"/>
    <arg name="linear_integral_limit" value="0.0"/>
    <arg name="angular_integral_limit" value="$(arg angular_integral_limit)"/>
    <arg name="wait_for_camera" value="true"/>
    <arg name="camera_topic" value="$(arg camera_topic)"/>
    <arg name="move_group_wait_timeout" value="$(arg move_group_wait_timeout)"/>
    <arg name="start_robot" value="$(arg start_robot)"/>
    <arg name="start_moveit" value="$(arg start_moveit)"/>
    <arg name="start_scan_merger" value="$(arg start_scan_merger)"/>
    <arg name="use_laser_safety" value="$(arg use_laser_safety)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <node if="$(arg start_path_trail)" pkg="aubo_mobile_follower"
        type="follower_path.py" name="line_follower_path" output="screen"/>

  <node if="$(arg start_rviz)" pkg="rviz" type="rviz"
        name="line_follow_rviz" output="screen"
        args="-d $(find aubo_mobile_follower)/rviz/line_follow.rviz">
    <env name="LIBGL_ALWAYS_SOFTWARE" value="1"/>
    <env name="__GLX_VENDOR_LIBRARY_NAME" value="mesa"/>
    <env name="MESA_LOADER_DRIVER_OVERRIDE" value="llvmpipe"/>
  </node>

  <node if="$(arg start_rqt_reconfigure)" pkg="rqt_reconfigure"
        type="rqt_reconfigure" name="line_follow_reconfigure" output="screen"/>
</launch>
