<?xml version="1.0"?>
<launch>
  <!-- Navigate with lidar protection, then move the hand camera to a reachable
       named observation pose and verify that images are arriving. -->
  <arg name="map_file" default="$(find aubo_mobile_navigation)/maps/map.yaml"/>
  <arg name="rviz" default="true"/>
  <arg name="start_navigation" default="true"/>
  <arg name="start_moveit" default="true"/>
  <arg name="goal_x" default="1.0"/>
  <arg name="goal_y" default="0.0"/>
  <arg name="goal_yaw" default="0.0"/>
  <arg name="goal_source" default="launch"/>
  <arg name="rviz_goal_topic" default="/nav_arm_coordinator/goal"/>
  <arg name="goal_wait_timeout" default="0.0"/>
  <arg name="camera_topic" default="/hand_camera/image_raw"/>
  <arg name="camera_timeout" default="5.0"/>

  <include file="$(find aubo_mobile_control)/launch/navigation_arm.launch">
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="start_navigation" value="$(arg start_navigation)"/>
    <arg name="start_moveit" value="$(arg start_moveit)"/>
    <arg name="goal_x" value="$(arg goal_x)"/>
    <arg name="goal_y" value="$(arg goal_y)"/>
    <arg name="goal_yaw" value="$(arg goal_yaw)"/>
    <arg name="goal_source" value="$(arg goal_source)"/>
    <arg name="rviz_goal_topic" value="$(arg rviz_goal_topic)"/>
    <arg name="goal_wait_timeout" value="$(arg goal_wait_timeout)"/>
    <arg name="pre_navigation_target" value="transport"/>
    <arg name="post_navigation_target" value="observe"/>
    <arg name="arm_target_type" value="named"/>
    <arg name="laser_safety" value="true"/>
    <arg name="wait_for_camera" value="true"/>
    <arg name="camera_topic" value="$(arg camera_topic)"/>
    <arg name="camera_timeout" value="$(arg camera_timeout)"/>
  </include>
</launch>
