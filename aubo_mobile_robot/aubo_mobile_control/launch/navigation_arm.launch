<?xml version="1.0"?>
<launch>
  <!-- Robot/Gazebo and ros_control must already run. -->
  <arg name="map_file" default="$(find aubo_mobile_navigation)/maps/map.yaml"/>
  <arg name="rviz" default="true"/>
  <arg name="start_navigation" default="true"/>
  <arg name="start_moveit" default="true"/>
  <arg name="goal_x" default="1.0"/><!-- 机器人抓取的位置 -->
  <arg name="goal_y" default="0.0"/>
  <arg name="goal_yaw" default="0.0"/>
  <arg name="goal_source" default="launch"/><!-- launch\rviz 防止两个数据源产生冲突-->
  <arg name="rviz_goal_topic" default="/nav_arm_coordinator/goal"/>
  <arg name="goal_wait_timeout" default="0.0"/>
  <arg name="pre_navigation_target" default="down"/>
  <arg name="post_navigation_target" default="up"/>
  <arg name="arm_target_type" default="named"/>
  <arg name="laser_safety" default="true"/>
  <arg name="wait_for_camera" default="false"/>
  <arg name="camera_topic" default="/hand_camera/image_raw"/>
  <arg name="camera_timeout" default="5.0"/>

  <group if="$(arg start_navigation)">
    <include file="$(find aubo_mobile_navigation)/launch/navigation.launch">
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="rviz" value="$(arg rviz)"/>
      <!-- RViz goals go through the coordinator in both modes. -->
      <arg name="nav_goal_topic" value="$(arg rviz_goal_topic)"/>
      <arg name="laser_safety" value="$(arg laser_safety)"/>
    </include>
  </group>

  <!-- Use real Gazebo/robot trajectory controllers; do not start a fake demo. -->
  <group if="$(arg start_moveit)">
    <include file="$(find aubo_mobile_moveit_config)/launch/move_group.launch">
      <arg name="allow_trajectory_execution" value="true"/>
      <arg name="fake_execution" value="false"/>
      <arg name="load_robot_description" value="false"/>
    </include>
  </group>

  <include file="$(find aubo_mobile_control)/launch/nav_arm_coordinator.launch">
    <arg name="goal_x" value="$(arg goal_x)"/>
    <arg name="goal_y" value="$(arg goal_y)"/>
    <arg name="goal_yaw" value="$(arg goal_yaw)"/>
    <arg name="goal_source" value="$(arg goal_source)"/>
    <arg name="rviz_goal_topic" value="$(arg rviz_goal_topic)"/>
    <arg name="goal_wait_timeout" value="$(arg goal_wait_timeout)"/>
    <arg name="pre_navigation_target" value="$(arg pre_navigation_target)"/>
    <arg name="post_navigation_target" value="$(arg post_navigation_target)"/>
    <arg name="arm_target_type" value="$(arg arm_target_type)"/>
    <arg name="wait_for_camera" value="$(arg wait_for_camera)"/>
    <arg name="camera_topic" value="$(arg camera_topic)"/>
    <arg name="camera_timeout" value="$(arg camera_timeout)"/>
  </include>
</launch>
