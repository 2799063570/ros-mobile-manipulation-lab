<launch>

  <!-- This file makes it easy to include the settings for sensor managers -->

  <!-- Params for 3D sensors config -->
  <rosparam command="load" file="$(find aubo_mobile_moveit_config)/config/sensors_3d.yaml" />

  <!-- Keep observations stable while the arm works.  The sorting coordinator
       clears this map after every chassis relocation. -->
  <param name="octomap_frame" type="string" value="base_link" />
  <param name="octomap_resolution" type="double" value="0.04" />
  <param name="max_range" type="double" value="2.5" />

  <!-- Load the robot specific sensor manager; this sets the moveit_sensor_manager ROS parameter -->
  <arg name="moveit_sensor_manager" default="aubo_mobile_robot" />
  <include file="$(find aubo_mobile_moveit_config)/launch/$(arg moveit_sensor_manager)_moveit_sensor_manager.launch.xml" />

</launch>
