# 工位分拣演示：保留现有控制面板与 MoveIt 规划场景，视角固定在桌面附近。
Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
  - Class: aubo_mobile_sorting/SortingPanel
    Name: Sorting controls and state
Preferences:
  PromptSaveOnExit: false
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Fixed Frame: odom
    Background Color: 32; 36; 42
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Color: 85; 95; 105
    - Class: rviz/RobotModel
      Name: Mobile manipulator
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Move Group Namespace: ""
      Planning Scene Topic: /move_group/monitored_planning_scene
      Robot Description: robot_description
      Planning Request:
        Planning Group: aubo_i5
        Interactive Marker Size: 0
      Planned Path:
        Trajectory Topic: /move_group/display_planned_path
        Show Robot Visual: true
      Scene Robot:
        Show Robot Visual: false
    - Class: rviz/Image
      Name: Hand camera RGB
      Enabled: true
      Image Topic: /hand_camera/image_raw
      Transport Hint: raw
      Queue Size: 2
    - Class: rviz/Image
      Name: Detection overlay
      Enabled: true
      Image Topic: /sorting/debug_image
      Transport Hint: raw
      Queue Size: 2
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 3.5
      Pitch: 0.65
      Yaw: 0.75
      Target Frame: <Fixed Frame>
      Focal Point: {X: 0.5, Y: 0.0, Z: 0.4}
    Saved: []
Window Geometry:
  Width: 1440
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
