Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      Visual Enabled: true
    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: map
      Enabled: true
      Name: Map
      Topic: /map
    - Class: rviz/LaserScan
      Color: 255; 0; 0
      Decay Time: 0
      Enabled: true
      Name: Merged Scan
      Position Transformer: XYZ
      Size (m): 0.03
      Style: Points
      Topic: /scan
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
Tools:
  - Class: rviz/Interact
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  - Class: rviz/Measure
  - Class: rviz/SetInitialPose
    Topic: /initialpose
  - Class: rviz/SetGoal
    Topic: /move_base_simple/goal
  - Class: rviz/PublishPoint
    Topic: /clicked_point
Value: true
Views:
  Current:
    Class: rviz/Orbit
    Distance: 12
    Focal Point:
      X: 0
      Y: 0
      Z: 0
    Name: Current View
    Pitch: 1.2
    Target Frame: <Fixed Frame>
    Yaw: 0.8
