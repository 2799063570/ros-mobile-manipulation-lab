<?xml version="1.0"?>
<sdf version="1.6">
  <world name="aubo_mobile_training">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <model name="boundary_walls">
      <static>true</static>
      <link name="walls_link">
        <collision name="north_collision">
          <pose>0 4 0.5 0 0 0</pose>
          <geometry><box><size>8 0.12 1</size></box></geometry>
        </collision>
        <visual name="north_visual">
          <pose>0 4 0.5 0 0 0</pose>
          <geometry><box><size>8 0.12 1</size></box></geometry>
          <material><ambient>0.72 0.72 0.75 1</ambient></material>
        </visual>
        <collision name="south_collision">
          <pose>0 -4 0.5 0 0 0</pose>
          <geometry><box><size>8 0.12 1</size></box></geometry>
        </collision>
        <visual name="south_visual">
          <pose>0 -4 0.5 0 0 0</pose>
          <geometry><box><size>8 0.12 1</size></box></geometry>
          <material><ambient>0.72 0.72 0.75 1</ambient></material>
        </visual>
        <collision name="east_collision">
          <pose>4 0 0.5 0 0 0</pose>
          <geometry><box><size>0.12 8 1</size></box></geometry>
        </collision>
        <visual name="east_visual">
          <pose>4 0 0.5 0 0 0</pose>
          <geometry><box><size>0.12 8 1</size></box></geometry>
          <material><ambient>0.72 0.72 0.75 1</ambient></material>
        </visual>
        <collision name="west_collision">
          <pose>-4 0 0.5 0 0 0</pose>
          <geometry><box><size>0.12 8 1</size></box></geometry>
        </collision>
        <visual name="west_visual">
          <pose>-4 0 0.5 0 0 0</pose>
          <geometry><box><size>0.12 8 1</size></box></geometry>
          <material><ambient>0.72 0.72 0.75 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="long_obstacle">
      <static>true</static>
      <pose>1.5 1.0 0.5 0 0 0.25</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 1.6 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 1.6 1.0</size></box></geometry>
          <material><ambient>0.25 0.45 0.75 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="low_obstacle">
      <static>true</static>
      <pose>-1.6 -1.2 0.4 0 0 -0.35</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 0.55 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.55 0.8</size></box></geometry>
          <material><ambient>0.75 0.45 0.20 1</ambient></material>
        </visual>
      </link>
    </model>

    <physics name="navigation_physics" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <ode>
        <solver><type>quick</type><iters>100</iters></solver>
      </ode>
    </physics>
  </world>
</sdf>
