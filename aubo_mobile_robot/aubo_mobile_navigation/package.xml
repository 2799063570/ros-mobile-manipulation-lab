<?xml version="1.0"?>
<package format="2">
  <name>aubo_mobile_navigation</name>
  <version>0.1.0</version>
  <description>ROS 1 mapping, localization and navigation for the AUBO mobile manipulator.</description>

  <maintainer email="wheeltec-client@todo.todo">wheeltec-client</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>amcl</exec_depend>
  <exec_depend>aubo_mobile_robot</exec_depend>
  <exec_depend>costmap_2d</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>gmapping</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>navfn</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rrt_exploration</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf</exec_depend>

  <export/>
</package>
