<?xml version="1.0"?>
<launch>
  <!-- Gazebo + dual lidar + GMapping + move_base + RRT exploration. -->
  <arg name="world" default="$(find aubo_mobile_navigation)/worlds/training.world"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.02"/>

  <arg name="local_eta" default="0.5"/>
  <arg name="global_eta" default="2.0"/>
  <arg name="info_radius" default="1.0"/>
  <arg name="info_multiplier" default="3.0"/>

  <include file="$(find aubo_mobile_navigation)/launch/mapping_nav_gazebo.launch">
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="z" value="$(arg z)"/>
  </include>

  <include file="$(find aubo_mobile_navigation)/launch/rrt_exploration.launch">
    <arg name="local_eta" value="$(arg local_eta)"/>
    <arg name="global_eta" value="$(arg global_eta)"/>
    <arg name="info_radius" value="$(arg info_radius)"/>
    <arg name="info_multiplier" value="$(arg info_multiplier)"/>
  </include>
</launch>
