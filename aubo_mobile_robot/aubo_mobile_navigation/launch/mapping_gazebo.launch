<?xml version="1.0"?>
<launch>
  <arg name="world" default="$(find aubo_mobile_navigation)/worlds/training.world"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.02"/>

  <include file="$(find aubo_mobile_robot)/launch/gazebo.launch">
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="z" value="$(arg z)"/>
  </include>

  <include file="$(find aubo_mobile_navigation)/launch/mapping.launch">
    <arg name="rviz" value="$(arg rviz)"/>
  </include>
</launch>
