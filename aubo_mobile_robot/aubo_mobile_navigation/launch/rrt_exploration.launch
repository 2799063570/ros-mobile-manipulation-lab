<?xml version="1.0"?>
<launch>
  <!--
    Single-robot RRT frontier exploration for the AUBO mobile manipulator.
    GMapping and move_base must already be running and publishing the live map
    and global costmap. The arm must be stowed before exploration starts.
  -->
  <arg name="map_topic" default="/map"/>
  <arg name="global_frame" default="map"/>
  <arg name="robot_frame" default="base_footprint"/>
  <arg name="global_costmap_topic" default="/move_base/global_costmap/costmap"/>
  <arg name="plan_service" default="/move_base/NavfnROS/make_plan"/>

  <arg name="local_eta" default="0.5"/>
  <arg name="global_eta" default="2.0"/>
  <arg name="info_radius" default="1.0"/>
  <arg name="info_multiplier" default="3.0"/>
  <arg name="hysteresis_radius" default="3.0"/>
  <arg name="hysteresis_gain" default="2.0"/>
  <arg name="costmap_clearing_threshold" default="70"/>
  <arg name="rate" default="20"/>

  <param name="namespace_init_count" value="1"/>

  <node pkg="rrt_exploration" type="global_rrt_detector"
        name="global_detector" output="screen">
    <param name="eta" value="$(arg global_eta)"/>
    <param name="map_topic" value="$(arg map_topic)"/>
  </node>

  <node pkg="rrt_exploration" type="local_rrt_detector"
        name="local_detector" output="screen">
    <param name="eta" value="$(arg local_eta)"/>
    <param name="map_topic" value="$(arg map_topic)"/>
    <param name="robot_frame" value="$(arg robot_frame)"/>
  </node>

  <node pkg="rrt_exploration" type="filter.py" name="filter" output="screen">
    <param name="map_topic" value="$(arg map_topic)"/>
    <param name="robot_frame" value="$(arg robot_frame)"/>
    <param name="global_costmap_topic" value="$(arg global_costmap_topic)"/>
    <param name="info_radius" value="$(arg info_radius)"/>
    <param name="costmap_clearing_threshold"
           value="$(arg costmap_clearing_threshold)"/>
    <param name="goals_topic" value="/detected_points"/>
    <param name="namespace" value=""/>
    <param name="n_robots" value="1"/>
    <param name="rate" value="$(arg rate)"/>
  </node>

  <node pkg="rrt_exploration" type="assigner.py" name="assigner" output="screen">
    <param name="map_topic" value="$(arg map_topic)"/>
    <param name="global_frame" value="$(arg global_frame)"/>
    <param name="robot_frame" value="$(arg robot_frame)"/>
    <param name="info_radius" value="$(arg info_radius)"/>
    <param name="info_multiplier" value="$(arg info_multiplier)"/>
    <param name="hysteresis_radius" value="$(arg hysteresis_radius)"/>
    <param name="hysteresis_gain" value="$(arg hysteresis_gain)"/>
    <param name="frontiers_topic" value="/filtered_points"/>
    <param name="n_robots" value="1"/>
    <param name="namespace" value=""/>
    <param name="delay_after_assignement" value="0.5"/>
    <param name="rate" value="$(arg rate)"/>
    <param name="plan_service" value="$(arg plan_service)"/>
  </node>
</launch>
