<?xml version="1.0"?>
<launch>
  <!-- The robot or Gazebo must already be running. -->
  <arg name="rviz" default="true"/>

  <include file="$(find aubo_mobile_navigation)/launch/mapping.launch">
    <arg name="rviz" value="false"/>
  </include>

  <!-- During live mapping, GMapping supplies /map and map -> odom. -->
  <include file="$(find aubo_mobile_navigation)/launch/move_base.launch.xml"/>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find aubo_mobile_navigation)/rviz/mapping.rviz"/>
</launch>
