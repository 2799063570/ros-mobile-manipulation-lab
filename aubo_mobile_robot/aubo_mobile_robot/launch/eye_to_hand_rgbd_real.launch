<?xml version="1.0"?>
<launch>
  <!-- RealSense eye-to-hand camera entry.  robot_state_publisher must already
       be using aubo_mobile_robot.xacro so it owns the calibrated mount TF. -->
  <arg name="serial_no" default=""/>
  <arg name="camera" default="workspace_camera"/>
  <arg name="initial_reset" default="true"/>
  <arg name="enable_sync" default="true"/>
  <arg name="align_depth" default="true"/>
  <arg name="enable_pointcloud" default="true"/>

  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="serial_no" value="$(arg serial_no)"/>
    <arg name="camera" value="$(arg camera)"/>
    <arg name="tf_prefix" value="$(arg camera)"/>
    <arg name="initial_reset" value="$(arg initial_reset)"/>
    <arg name="enable_sync" value="$(arg enable_sync)"/>
    <arg name="align_depth" value="$(arg align_depth)"/>
    <arg name="enable_pointcloud" value="$(arg enable_pointcloud)"/>
    <!-- A single calibrated TF authority prevents duplicate/conflicting trees. -->
    <arg name="publish_tf" value="false"/>
  </include>
</launch>
