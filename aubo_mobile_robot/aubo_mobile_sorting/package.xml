<?xml version="1.0"?>
<package format="2">
  <name>aubo_mobile_sorting</name>
  <version>0.1.0</version>
  <description>Gazebo camera-guided color block grasping and sorting with MoveIt.</description>

  <maintainer email="wheeltec-client@todo.todo">wheeltec-client</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>actionlib</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>aubo_mobile_moveit_config</exec_depend>
  <exec_depend>aubo_mobile_perception</exec_depend>
  <exec_depend>aubo_mobile_robot</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>image_view</exec_depend>
  <exec_depend>moveit_commander</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>

  <export/>
</package>
