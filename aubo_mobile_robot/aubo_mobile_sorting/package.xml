<?xml version="1.0"?>
<package format="2">
  <name>aubo_mobile_sorting</name>
  <version>0.2.0</version>
  <description>Gazebo camera-guided color block grasping and sorting with MoveIt.</description>

  <maintainer email="wheeltec-client@todo.todo">wheeltec-client</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>pluginlib</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>rviz</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>std_srvs</build_depend>

  <build_export_depend>pluginlib</build_export_depend>
  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>rviz</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>std_srvs</build_export_depend>

  <exec_depend>actionlib</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>aubo_mobile_moveit_config</exec_depend>
  <exec_depend>aubo_mobile_perception</exec_depend>
  <exec_depend>aubo_mobile_robot</exec_depend>
  <exec_depend>aubo_gazebo_plugins</exec_depend>
  <exec_depend>aubo_sorting_core</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>image_view</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <export>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
