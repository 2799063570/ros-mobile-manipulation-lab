<?xml version="1.0"?>
<sdf version="1.6">
  <world name="aubo_color_sorting">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Robot arm base is at world z=0.33 when the robot is spawned at z=0.02.
         The table top is therefore z=0.12 in the arm's base_link frame. -->
    <model name="sorting_table">
      <static>true</static>
      <pose>0.80 0 0.25 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry><box><size>0.80 1.20 0.40</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.80 1.20 0.40</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.47 1</ambient>
            <diffuse>0.55 0.55 0.57 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual-only sorting pads: blocks still rest on the common table plane. -->
    <model name="red_pad">
      <static>true</static><pose>0.50 -0.32 0.452 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.14 0.14 0.004</size></box></geometry>
        <material><ambient>0.45 0.02 0.02 1</ambient><diffuse>0.8 0.03 0.03 1</diffuse></material>
      </visual></link>
    </model>
    <model name="green_pad">
      <static>true</static><pose>0.65 -0.32 0.452 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.14 0.14 0.004</size></box></geometry>
        <material><ambient>0.02 0.40 0.02 1</ambient><diffuse>0.03 0.8 0.03 1</diffuse></material>
      </visual></link>
    </model>
    <model name="blue_pad">
      <static>true</static><pose>0.50 0.32 0.452 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.14 0.14 0.004</size></box></geometry>
        <material><ambient>0.02 0.02 0.45 1</ambient><diffuse>0.03 0.03 0.8 1</diffuse></material>
      </visual></link>
    </model>

    <model name="red_block">
      <pose>0.58 -0.12 0.475 0 0 0</pose>
      <link name="block_link">
        <inertial><mass>0.06</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.8 0.02 0.02 1</ambient><diffuse>1 0.02 0.02 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="green_block">
      <pose>0.66 0 0.475 0 0 0.25</pose>
      <link name="block_link">
        <inertial><mass>0.06</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.02 0.8 0.02 1</ambient><diffuse>0.02 1 0.02 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_block">
      <pose>0.58 0.12 0.475 0 0 -0.2</pose>
      <link name="block_link">
        <inertial><mass>0.06</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.02 0.02 0.8 1</ambient><diffuse>0.02 0.02 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <physics name="sorting_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode><solver><type>quick</type><iters>150</iters><sor>1.3</sor></solver></ode>
    </physics>
  </world>
</sdf>
