    <physics name="four_table_physics" type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate><ode><solver><type>quick</type><iters>150</iters><sor>1.3</sor></solver></ode></physics>
  </world>
</sdf>
