<?xml version="1.0"?>
<sdf version="1.6">
  <world name="aubo_navigation_sorting">
    <plugin name="aubo_mobile_sorting_grasp"
            filename="libaubo_grasp_attach_plugin.so">
      <robot_model>aubo_mobile_robot</robot_model>
      <palm_link>wrist3_Link</palm_link>
      <object_link>block_link</object_link>
      <max_attach_distance>0.18</max_attach_distance>
      <attach_topic>/sorting/grasp/attach</attach_topic>
      <detach_topic>/sorting/grasp/detach</detach_topic>
      <status_topic>/sorting/grasp/status</status_topic>
    </plugin>

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- This task owns its fixed overhead RGB-D camera.  It is centred above
         the source blocks, with no physical connection to the mobile robot. -->
    <model name="workspace_camera">
      <static>true</static>
      <pose>2.82 0 2.00 0 1.57079632679 0</pose>
      <link name="workspace_camera_link">
        <collision name="camera_body_collision">
          <geometry><box><size>0.090 0.025 0.025</size></box></geometry>
        </collision>
        <visual name="camera_body_visual">
          <geometry><box><size>0.090 0.025 0.025</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material>
        </visual>
        <sensor type="depth" name="workspace_camera_rgbd">
          <pose>0.045 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <update_rate>15</update_rate>
          <camera name="workspace_camera_sensor">
            <horizontal_fov>1.308996939</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.15</near><far>3.0</far></clip>
          </camera>
          <plugin name="workspace_camera_gazebo_ros_openni" filename="libgazebo_ros_openni_kinect.so">
            <cameraName>workspace_camera</cameraName>
            <imageTopicName>color/image_raw</imageTopicName>
            <cameraInfoTopicName>color/camera_info</cameraInfoTopicName>
            <depthImageTopicName>aligned_depth_to_color/image_raw</depthImageTopicName>
            <depthImageCameraInfoTopicName>aligned_depth_to_color/camera_info</depthImageCameraInfoTopicName>
            <pointCloudTopicName>depth/color/points</pointCloudTopicName>
            <frameName>workspace_camera_color_optical_frame</frameName>
            <pointCloudCutoff>0.15</pointCloudCutoff>
            <pointCloudCutoffMax>3.0</pointCloudCutoffMax>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- 10 x 6 m room. The robot starts at (-2.5, 0) and docks near (2.15, 0). -->
    <model name="boundary_walls">
      <static>true</static>
      <link name="walls_link">
        <collision name="north_collision"><pose>0 3 0.5 0 0 0</pose><geometry><box><size>10 0.12 1</size></box></geometry></collision>
        <visual name="north_visual"><pose>0 3 0.5 0 0 0</pose><geometry><box><size>10 0.12 1</size></box></geometry><material><ambient>0.72 0.72 0.75 1</ambient></material></visual>
        <collision name="south_collision"><pose>0 -3 0.5 0 0 0</pose><geometry><box><size>10 0.12 1</size></box></geometry></collision>
        <visual name="south_visual"><pose>0 -3 0.5 0 0 0</pose><geometry><box><size>10 0.12 1</size></box></geometry><material><ambient>0.72 0.72 0.75 1</ambient></material></visual>
        <collision name="east_collision"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.12 6 1</size></box></geometry></collision>
        <visual name="east_visual"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.12 6 1</size></box></geometry><material><ambient>0.72 0.72 0.75 1</ambient></material></visual>
        <collision name="west_collision"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.12 6 1</size></box></geometry></collision>
        <visual name="west_visual"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.12 6 1</size></box></geometry><material><ambient>0.72 0.72 0.75 1</ambient></material></visual>
      </link>
    </model>

    <!-- Forces the navigation planner to choose a path while leaving a wide aisle. -->
    <model name="route_obstacle">
      <static>true</static><pose>-0.2 0.75 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 1.1 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 1.1 0.9</size></box></geometry><material><ambient>0.22 0.42 0.72 1</ambient></material></visual>
      </link>
    </model>

    <!-- The dock leaves collision clearance while retaining the reference
         sorting scene's arm/table geometry to within 5 cm. -->
    <model name="sorting_table">
      <static>true</static><pose>3.00 0 0.25 0 0 0</pose>
      <link name="table_link">
        <collision name="collision"><geometry><box><size>0.80 1.20 0.40</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.80 1.20 0.40</size></box></geometry><material><ambient>0.45 0.45 0.47 1</ambient><diffuse>0.55 0.55 0.57 1</diffuse></material></visual>
      </link>
    </model>

    <model name="red_pad"><static>true</static><pose>2.66 -0.24 0.452 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.14 0.14 0.004</size></box></geometry><material><ambient>0.45 0.02 0.02 1</ambient><diffuse>0.8 0.03 0.03 1</diffuse></material></visual></link></model>
    <model name="green_pad"><static>true</static><pose>2.80 -0.24 0.452 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.14 0.14 0.004</size></box></geometry><material><ambient>0.02 0.40 0.02 1</ambient><diffuse>0.03 0.8 0.03 1</diffuse></material></visual></link></model>
    <model name="blue_pad"><static>true</static><pose>2.66 0.24 0.452 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.14 0.14 0.004</size></box></geometry><material><ambient>0.02 0.02 0.45 1</ambient><diffuse>0.03 0.03 0.8 1</diffuse></material></visual></link></model>

    <model name="red_block">
      <pose>2.78 -0.12 0.470 0 0 0</pose><link name="block_link"><gravity>true</gravity><kinematic>false</kinematic>
        <inertial><mass>0.04</mass><inertia><ixx>0.000011</ixx><iyy>0.000011</iyy><izz>0.000011</izz></inertia></inertial>
        <collision name="collision"><max_contacts>20</max_contacts><geometry><box><size>0.04 0.04 0.04</size></box></geometry><surface><friction><ode><mu>20.0</mu><mu2>20.0</mu2></ode></friction><contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact></surface></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><material><ambient>0.8 0.02 0.02 1</ambient><diffuse>1 0.02 0.02 1</diffuse></material></visual>
      </link>
    </model>
    <model name="green_block">
      <pose>2.86 0 0.470 0 0 0</pose><link name="block_link"><gravity>true</gravity><kinematic>false</kinematic>
        <inertial><mass>0.04</mass><inertia><ixx>0.000011</ixx><iyy>0.000011</iyy><izz>0.000011</izz></inertia></inertial>
        <collision name="collision"><max_contacts>20</max_contacts><geometry><box><size>0.04 0.04 0.04</size></box></geometry><surface><friction><ode><mu>20.0</mu><mu2>20.0</mu2></ode></friction><contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact></surface></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><material><ambient>0.02 0.8 0.02 1</ambient><diffuse>0.02 1 0.02 1</diffuse></material></visual>
      </link>
    </model>
    <model name="blue_block">
      <pose>2.78 0.12 0.470 0 0 0</pose><link name="block_link"><gravity>true</gravity><kinematic>false</kinematic>
        <inertial><mass>0.04</mass><inertia><ixx>0.000011</ixx><iyy>0.000011</iyy><izz>0.000011</izz></inertia></inertial>
        <collision name="collision"><max_contacts>20</max_contacts><geometry><box><size>0.04 0.04 0.04</size></box></geometry><surface><friction><ode><mu>20.0</mu><mu2>20.0</mu2></ode></friction><contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact></surface></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><material><ambient>0.02 0.02 0.8 1</ambient><diffuse>0.02 0.02 1 1</diffuse></material></visual>
      </link>
    </model>

    <physics name="nav_sorting_physics" type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate><ode><solver><type>quick</type><iters>150</iters><sor>1.3</sor></solver></ode></physics>
  </world>
</sdf>
