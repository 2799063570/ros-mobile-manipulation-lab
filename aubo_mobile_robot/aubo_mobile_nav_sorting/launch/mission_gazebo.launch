<?xml version="1.0"?>
<launch>
  <arg name="world" default="$(find aubo_mobile_nav_sorting)/worlds/nav_sorting.world"/>
  <arg name="map_file" default="$(find aubo_mobile_nav_sorting)/maps/nav_sorting.yaml"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="debug_view" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="auto_start" default="true"/>
  <arg name="goal_x" default="2.15"/>
  <arg name="goal_y" default="0.0"/>
  <arg name="goal_yaw" default="0.0"/>
  <arg name="direct_dock" default="true"/>

  <include file="$(find aubo_mobile_robot)/launch/gazebo.launch">
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="x" value="-2.50"/>
    <arg name="y" value="0.0"/>
    <arg name="z" value="0.02"/>
  </include>

  <!-- nav_sorting.world owns a fixed camera above the sorting target.  map is
       the stable scene frame while the robot navigates beneath it. -->
  <include file="$(find aubo_description)/launch/eye_to_hand_camera_tf.launch">
    <arg name="parent_frame" value="map"/>
    <arg name="x" value="2.82"/>
    <arg name="y" value="0.0"/>
    <arg name="z" value="2.0"/>
  </include>

  <include file="$(find aubo_mobile_navigation)/launch/navigation.launch">
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <!-- Near the table, rotate recovery can repeatedly spin against the local
         costmap.  This mission stops at pre-dock and performs final docking
         with its own low-speed straight controller, so use a calmer profile. -->
    <arg name="clearing_rotation_allowed" value="false"/>
    <arg name="max_vel_theta" value="0.45"/>
    <arg name="min_vel_theta" value="0.05"/>
    <arg name="xy_goal_tolerance" value="0.07"/>
    <arg name="yaw_goal_tolerance" value="0.04"/>
  </include>

  <!-- Seed AMCL after it subscribes; this avoids requiring an RViz click. -->
  <node pkg="aubo_mobile_nav_sorting" type="publish_initial_pose.py"
        name="nav_sorting_initial_pose" output="screen">
    <param name="x" value="-2.50"/>
    <param name="y" value="0.0"/>
    <param name="yaw" value="0.0"/>
  </node>

  <include file="$(find aubo_mobile_moveit_config)/launch/move_group.launch">
    <arg name="allow_trajectory_execution" value="true"/>
    <arg name="fake_execution" value="false"/>
    <arg name="load_robot_description" value="false"/>
    <!-- Parameterized collision objects populate the PlanningScene directly. -->
    <arg name="use_sensor_manager" value="false"/>
  </include>

  <include file="$(find aubo_mobile_sorting)/launch/sorting.launch">
    <arg name="config" value="$(find aubo_mobile_nav_sorting)/config/sorting.yaml"/>
    <arg name="debug_view" value="$(arg debug_view)"/>
    <arg name="auto_move_to_observation" value="false"/>
    <arg name="auto_start" value="false"/>
  </include>

  <include file="$(find aubo_mobile_nav_sorting)/launch/mission.launch">
    <arg name="auto_start" value="$(arg auto_start)"/>
    <arg name="goal_x" value="$(arg goal_x)"/>
    <arg name="goal_y" value="$(arg goal_y)"/>
    <arg name="goal_yaw" value="$(arg goal_yaw)"/>
    <arg name="direct_dock" value="$(arg direct_dock)"/>
  </include>
</launch>
