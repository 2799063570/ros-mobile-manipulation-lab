<?xml version="1.0"?>
<launch>
  <arg name="world" default="$(find aubo_mobile_nav_sorting)/worlds/nav_sorting.world"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="paused" default="false"/>

  <include file="$(find aubo_mobile_robot)/launch/gazebo.launch">
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="x" value="-2.50"/>
    <arg name="y" value="0.0"/>
    <arg name="z" value="0.02"/>
  </include>

  <include file="$(find aubo_mobile_navigation)/launch/mapping.launch">
    <arg name="rviz" value="$(arg rviz)"/>
  </include>
</launch>
