<?xml version="1.0"?>
<launch>
  <arg name="world" default="$(find aubo_mobile_nav_sorting)/worlds/four_tables.world"/>
  <arg name="map_file" default="$(find aubo_mobile_nav_sorting)/maps/four_tables.yaml"/>
  <arg name="mission_config" default="$(find aubo_mobile_nav_sorting)/config/four_tables.yaml"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="debug_view" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="auto_start" default="false"/>
  <arg name="mission_implementation" default="cpp"/><!-- Accepted values: python, cpp -->
  <!-- Accepted values: teb, dwa. An unknown value intentionally fails while
       roslaunch evaluates this lookup instead of silently selecting a planner. -->
  <arg name="local_planner" default="teb"/>
  <arg name="base_local_planner_class"
       value="$(eval {'teb': 'teb_local_planner/TebLocalPlannerROS', 'dwa': 'dwa_local_planner/DWAPlannerROS'}[arg('local_planner')])"/>

  <include file="$(find aubo_mobile_robot)/launch/gazebo.launch">
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="x" value="-4.00"/>
    <arg name="y" value="0.0"/>
    <arg name="z" value="0.02"/>
  </include>

  <include file="$(find aubo_mobile_navigation)/launch/navigation.launch">
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="base_local_planner" value="$(arg base_local_planner_class)"/>
    <arg name="clearing_rotation_allowed" value="false"/>
    <arg name="max_vel_theta" value="0.35"/>
    <arg name="min_vel_theta" value="0.03"/>
    <arg name="xy_goal_tolerance" value="0.08"/>
    <arg name="yaw_goal_tolerance" value="0.08"/>
    <arg name="use_navigation_profile" value="true"/>
    <arg name="navigation_profile_file"
         value="$(find aubo_mobile_nav_sorting)/config/four_tables_navigation.yaml"/>
  </include>

  <node pkg="aubo_mobile_nav_sorting" type="publish_initial_pose.py"
        name="four_tables_initial_pose" output="screen">
    <param name="x" value="-4.00"/>
    <param name="y" value="0.0"/>
    <param name="yaw" value="0.0"/>
  </node>

  <include file="$(find aubo_mobile_moveit_config)/launch/move_group.launch">
    <arg name="allow_trajectory_execution" value="true"/>
    <arg name="fake_execution" value="false"/>
    <arg name="load_robot_description" value="false"/>
    <arg name="use_sensor_manager" value="false"/>
  </include>

  <include file="$(find aubo_mobile_sorting)/launch/sorting.launch">
    <arg name="config" value="$(find aubo_mobile_nav_sorting)/config/sorting.yaml"/>
    <arg name="debug_view" value="$(arg debug_view)"/>
    <arg name="auto_move_to_observation" value="false"/>
    <arg name="auto_start" value="false"/>
    <arg name="color_detector_config" value="$(find aubo_mobile_nav_sorting)/config/four_tables_colors.yaml"/>
  </include>

  <include file="$(find aubo_mobile_nav_sorting)/launch/mission.launch">
    <arg name="config" value="$(arg mission_config)"/>
    <arg name="auto_start" value="$(arg auto_start)"/>
    <arg name="direct_dock" value="true"/>
    <arg name="implementation" value="$(arg mission_implementation)"/>
  </include>
</launch>
