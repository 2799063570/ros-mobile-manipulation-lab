<?xml version="1.0"?>
<launch>
  <!-- TF for a scene-owned overhead RGB-D camera.  The camera is independent
       of the robot model and looks vertically down from its scene pose. -->
  <arg name="parent_frame" default="odom"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="2.0"/>

  <!-- tf2_ros uses x y z yaw pitch roll.  Positive pitch turns the Gazebo
       camera's +X viewing direction toward world -Z. -->
  <node pkg="tf2_ros" type="static_transform_publisher"
        name="workspace_camera_scene_tf"
        args="$(arg x) $(arg y) $(arg z) 0 1.57079632679 0 $(arg parent_frame) workspace_camera_link"/>

  <node pkg="tf2_ros" type="static_transform_publisher"
        name="workspace_camera_depth_tf"
        args="0.045 0 0 0 0 0 workspace_camera_link workspace_camera_depth_frame"/>
  <node pkg="tf2_ros" type="static_transform_publisher"
        name="workspace_camera_depth_optical_tf"
        args="0 0 0 -1.57079632679 0 -1.57079632679 workspace_camera_depth_frame workspace_camera_depth_optical_frame"/>

  <node pkg="tf2_ros" type="static_transform_publisher"
        name="workspace_camera_color_tf"
        args="0.045 0 0 0 0 0 workspace_camera_link workspace_camera_color_frame"/>
  <node pkg="tf2_ros" type="static_transform_publisher"
        name="workspace_camera_color_optical_tf"
        args="0 0 0 -1.57079632679 0 -1.57079632679 workspace_camera_color_frame workspace_camera_color_optical_frame"/>
</launch>
