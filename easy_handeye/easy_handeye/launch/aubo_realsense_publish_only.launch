<?xml version="1.0"?>
<launch>
    <arg name="eye_on_hand" default="false" />
    <arg name="namespace_prefix" default="aubo_realsense_handeye" />
    <arg name="robot_base_frame" default="base_link" />
    <arg name="robot_effector_frame" default="gripper_link" />
    <arg name="tracking_base_frame" default="camera_link" />
    <arg name="calibration_file" default="$(find aubo_ros_control)/config/aubo_realsense_handeye_eye_on_base.yaml" />
    <arg name="inverse" default="false" />

    <include file="$(find easy_handeye)/launch/publish.launch">
        <arg name="eye_on_hand" value="$(arg eye_on_hand)" />
        <arg name="namespace_prefix" value="$(arg namespace_prefix)" />
        <arg if="$(arg eye_on_hand)" name="robot_effector_frame" value="$(arg robot_effector_frame)" />
        <arg unless="$(arg eye_on_hand)" name="robot_base_frame" value="$(arg robot_base_frame)" />
        <arg name="tracking_base_frame" value="$(arg tracking_base_frame)" />
        <arg name="inverse" value="$(arg inverse)" />
        <arg name="calibration_file" value="$(arg calibration_file)" />
    </include>

    <!-- static transform to correct optical-frame roll (generated by handeye_fix.py) -->
    <node pkg="tf" type="static_transform_publisher" name="handeye_fix_optical" args="-0.015 -0.652 0.91 -0.003535182172804397 -0.0028281457382434527 -0.9997495184690832 0.021918129471387292 base_link camera_color_optical_frame 100"/>
</launch>