<?xml version="1.0" ?>
<launch>
    <arg name="eye_on_hand" default="false" />
    <arg name="namespace_prefix" default="aubo_realsense_handeye" />
    <arg name="robot_base_frame" default="base_link" />
    <arg name="robot_effector_frame" default="gripper_link" />
    <arg name="tracking_base_frame" default="camera_color_optical_frame" />
    <arg name="tracking_marker_frame" default="aruco_marker_frame" />

    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="filters" value="pointcloud"/>
    </include>

    <!-- 识别Aruco码的位姿(相对于相机坐标系) tf->aruco_marker_frame -->
    <node name="aruco_tracker" pkg="aruco_ros" type="single">
        <remap from="/camera_info" to="/camera/color/camera_info" />
        <remap from="/image" to="/camera/color/image_raw" />
        <param name="marker_size" value="0.1" /> 
        <param name="marker_id" value="30" /> 
        <param name="reference_frame" value="$(arg tracking_base_frame)" />
        <param name="ref_frame" value="$(arg tracking_base_frame)" />
        <param name="camera_frame" value="$(arg tracking_base_frame)" />
        <param name="marker_frame" value="aruco_marker_frame" />
    </node>

    <!-- Keep a subscriber on the ArUco transform topic so the node keeps processing images. -->
    <node pkg="topic_tools" type="relay" name="aruco_tracker_transform_relay"
          args="/aruco_tracker/transform /aruco_tracker/transform_keepalive" output="screen" />

    <include file="$(find easy_handeye)/launch/calibrate.launch">
        <arg name="namespace_prefix" value="$(arg namespace_prefix)" />
        <arg name="eye_on_hand" value="$(arg eye_on_hand)" />
        <arg name="move_group_namespace" value="/" />
        <arg name="move_group" value="arm" />
        <arg name="robot_base_frame" value="$(arg robot_base_frame)" />
        <arg name="robot_effector_frame" value="$(arg robot_effector_frame)" />
        <arg name="tracking_base_frame" value="$(arg tracking_base_frame)" />
        <arg name="tracking_marker_frame" value="$(arg tracking_marker_frame)" />
        <arg name="freehand_robot_movement" value="true" />
        <arg name="publish_dummy" value="false" />
        <arg name="start_rviz" value="false" />
    </include>
</launch>
